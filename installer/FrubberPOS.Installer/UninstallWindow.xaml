<Window x:Class="FrubberPOS.Installer.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS — Desinstalar" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        FontFamily="pack://application:,,,/Fonts/#Inter"
        MouseLeftButtonDown="OnDragMove">
    <Border CornerRadius="18" Background="White" Margin="14">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270" Color="#132E3F" Opacity="0.15"/>
        </Border.Effect>
        <StackPanel Margin="26,22">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#3DE0C6" Offset="0"/>
                                <GradientStop Color="#0B897E" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="F" Foreground="White" FontSize="17" FontWeight="ExtraBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,2,0,0">
                        <TextBlock Text="Desinstalar Frubber POS" FontSize="17" FontWeight="Bold" Foreground="#102132"/>
                        <TextBlock Text="Versión 1.0.0" Foreground="#83939B" FontSize="10"/>
                    </StackPanel>
                </StackPanel>
                <Button HorizontalAlignment="Right" VerticalAlignment="Top" Content="✕" Click="OnCloseClick"
                        Background="Transparent" BorderThickness="0" Foreground="#8BA0AB" Cursor="Hand" Padding="6,2"/>
            </Grid>

            <TextBlock x:Name="QuestionText" Margin="0,18,0,0" TextWrapping="Wrap" FontSize="12" Foreground="#3B505C"
                       Text="Se va a quitar el programa de este computador."/>
            <Border BorderBrush="#DEF0EC" BorderThickness="1" CornerRadius="12" Background="#F4FBF9"
                    Margin="0,12,0,0" Padding="13">
                <StackPanel Orientation="Horizontal">
                    <Border Width="27" Height="27" CornerRadius="8" Background="#E1F5F0">
                        <TextBlock Text="i" Foreground="#188F7E" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/>
                    </Border>
                    <TextBlock FontSize="11" TextWrapping="Wrap" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="#47716B"
                               Text="Tus datos del negocio (ventas, productos, licencia) NO se borran: quedan guardados en C:\ProgramData\FrubberPOS."/>
                </StackPanel>
            </Border>

            <StackPanel x:Name="ProgressWrap" Visibility="Collapsed" Margin="0,18,0,0">
                <TextBlock x:Name="ProgressLabel" Foreground="#506671" FontSize="11" FontWeight="SemiBold"/>
                <Border Height="8" CornerRadius="99" Background="#EAF1F1" Margin="0,10,0,0">
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" Width="0" CornerRadius="99" Background="#16B6A5"/>
                </Border>
            </StackPanel>
            <TextBlock x:Name="ErrorText" Foreground="#B91C1C" FontSize="11" TextWrapping="Wrap"
                       Margin="0,10,0,0" Visibility="Collapsed"/>

            <Grid Margin="0,20,0,4">
                <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancelar" Style="{StaticResource SecondaryButton}" MinWidth="100"
                            Click="OnCloseClick" IsCancel="True"/>
                    <Button x:Name="UninstallBtn" Content="Sí, desinstalar" Style="{StaticResource PrimaryButton}"
                            Margin="9,0,0,0" Click="OnUninstallClick"/>
                </StackPanel>
                <Button x:Name="DoneBtn" Content="Cerrar" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Right" Visibility="Collapsed" Click="OnCloseClick" MinWidth="110"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
