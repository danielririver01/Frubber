<Window x:Class="FrubberPOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS" Height="600" Width="900"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,6">
            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Cerrar sesión" Command="{Binding SignOutCommand}" Margin="16,0,0,0" Padding="12,4"/>
        </StackPanel>
        <ListBox DockPanel.Dock="Left" Width="170" Margin="12,0,0,12"
                 ItemsSource="{Binding MenuItems}" DisplayMemberPath="Title"
                 SelectedItem="{Binding SelectedEntry}"/>
        <StackPanel Margin="24">
            <TextBlock Text="{Binding PageTitle}" FontSize="24" FontWeight="Bold"/>
            <TextBlock Text="{Binding PageDescription}" Margin="0,8,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>
