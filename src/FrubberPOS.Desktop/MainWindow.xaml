<Window x:Class="FrubberPOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FrubberPOS.Desktop.ViewModels"
        xmlns:views="clr-namespace:FrubberPOS.Desktop.Views"
        Title="Frubber POS" Height="600" Width="900" MinWidth="880" MinHeight="480"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        SizeChanged="OnSizeChanged"
        PreviewKeyDown="OnKeyDown">
    <!--
        Shell JHO-69 = frubber-pos.html (prototipo integrado del dueño,
        2026-10-02): sidebar 220 con marca + menú de letras-chip y badge de
        conteo; encabezado sobre el lienzo con píldoras y chip de usuario.
    -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Grid>
        <DockPanel>
        <!-- ===== Barra lateral ===== -->
        <Border x:Name="Sidebar" DockPanel.Dock="Left" Width="220"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,1,0"
                Padding="12,20,12,16">
            <DockPanel>
                <!-- Marca: logo degradado + nombre -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,4,8,20">
                    <Border Style="{DynamicResource BrandLogo}">
                        <TextBlock Text="F" Foreground="White" FontWeight="Bold" FontSize="17"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel x:Name="BrandText" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Frubber" FontSize="15" FontWeight="Bold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="POS" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedTextBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Pie: rol, cerrar sesión, aviso offline -->
                <DockPanel DockPanel.Dock="Bottom" Margin="4,0,4,0">
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource TrialBrush}"
                            CornerRadius="10" Padding="12,9" Margin="0,12,0,0"
                            AutomationProperties.Name="Estado de conexión">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource OfflineTextBrush}"
                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Modo fuera de línea" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource OfflineTextBrush}" Margin="7,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button DockPanel.Dock="Bottom" Content="Cerrar sesión" Command="{Binding SignOutCommand}"
                            Style="{DynamicResource SecondaryButton}" MinHeight="40" FontSize="13"
                            AutomationProperties.Name="Cerrar sesión"/>
                    <Border x:Name="RoleBadge" DockPanel.Dock="Bottom" Margin="0,0,4,10"
                            Background="{DynamicResource MintBrush}" CornerRadius="999" Padding="10,4"
                            HorizontalAlignment="Left"
                            AutomationProperties.Name="Rol del usuario">
                        <TextBlock Text="{Binding RoleBadgeText}" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </Border>
                </DockPanel>

                <!-- Menú -->
                <ListBox x:Name="MenuList"
                         ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedEntry}"
                         ItemContainerStyle="{DynamicResource NavMenuItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         AutomationProperties.Name="Menú principal">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:MenuEntry}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Chip" Style="{DynamicResource NavKeyChip}">
                                    <TextBlock x:Name="ChipLetter" Text="{Binding Icon}" FontSize="11"
                                               FontWeight="Bold" Foreground="{DynamicResource TextSubBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock x:Name="Label" Grid.Column="1" Text="{Binding Title}" FontSize="14"
                                           FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}"
                                           Margin="10,0,0,0" VerticalAlignment="Center"/>
                                <Border x:Name="Badge" Grid.Column="2" Style="{DynamicResource NavCountBadge}"
                                        Visibility="{Binding BadgeVisible, Converter={StaticResource BoolToVis}}"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Conteo del borrador de venta">
                                    <TextBlock Text="{Binding BadgeCount}" FontSize="10.5" FontWeight="Bold"
                                               Foreground="White" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                                    <Setter TargetName="Label" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource MintBorderBrush}"/>
                                    <Setter TargetName="ChipLetter" Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Contenido ===== -->
        <DockPanel Background="{DynamicResource AppBackground}">
            <!-- Encabezado sobre el lienzo: título + sub, píldoras y chip de usuario -->
            <Border DockPanel.Dock="Top" Padding="24,20,24,12"
                    AutomationProperties.Name="Encabezado de página">
        <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- JHO-67 (pos-2): caja cerrada = pastilla gris neutra. -->
                        <Border Margin="8,0,0,0" CornerRadius="999" Height="30" Padding="12,0"
                                Background="{DynamicResource PillNeutralBrush}"
                                Visibility="{Binding CashClosedPillVisible, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Estado de caja cerrada">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource PillNeutralTextBrush}"/>
                                <TextBlock Text="Caja cerrada" Foreground="{DynamicResource PillNeutralTextBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="8,0,0,0" CornerRadius="999" Height="30" Padding="12,0"
                                Background="{DynamicResource MintBrush}"
                                Visibility="{Binding CashPillVisible, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Estado de caja">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Caja abierta" Foreground="{DynamicResource PrimaryBrush}"
                                           FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="LicensePill" Margin="8,0,0,0" CornerRadius="999" Height="30"
                                Padding="12,0" Background="{DynamicResource MintBrush}"
                                Visibility="{Binding LicenseBadgeVisible, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Estado de licencia">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LicensePillIcon" Text="✓" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LicenseBadgeIsTrial}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TrialTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="LicensePillText" Text="{Binding LicenseBadgeText}"
                                           FontSize="12" FontWeight="SemiBold" Margin="7,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LicenseBadgeIsTrial}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource TrialTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource MintBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LicenseBadgeIsTrial}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource TrialBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <Border Margin="8,0,0,0" Padding="10,0,0,0" BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource BorderSoftBrush}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="36" Height="36" CornerRadius="999"
                                        Background="{DynamicResource AvatarGradient}">
                                    <TextBlock Text="{Binding UserInitials}" Foreground="White"
                                               FontWeight="SemiBold" FontSize="13"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding RoleBadgeText}" FontSize="10" FontWeight="Bold"
                                               Foreground="{DynamicResource MutedTextBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding PageTitle}" Style="{DynamicResource PageTitle}"/>
                        <TextBlock Text="{Binding PageDescription}" Margin="0,2,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PageDescription}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DockPanel>
            </Border>

            <ContentControl Content="{Binding CurrentPage}" Margin="24,4,24,20"/>
        </DockPanel>
    </DockPanel>

        <!--
            Capa de bloqueo (JHO-64): overlay opaco nativo DENTRO del shell —
            la ventana nunca se cierra ni se sustituye. El shell queda intacto
            debajo y el LoginCardView (modo lock) pide el PIN para reanudar.
            Se activa solo con el botón "Cerrar sesión" (dueño: sin auto-lock).
        -->
        <Grid x:Name="LockLayer" Visibility="Collapsed">
            <Border Background="{DynamicResource LoginBackdrop}"/>
            <views:LoginCardView x:Name="LockCard" IsLockMode="True"/>
        </Grid>
    </Grid>
</Window>
