<Window x:Class="FrubberPOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS" Height="600" Width="900" MinWidth="880" MinHeight="480"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        SizeChanged="OnSizeChanged"
        KeyDown="OnKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <DockPanel>
        <!-- ===== Barra lateral (DESIGN.md: chips de ícono, activo menta, rol abajo) ===== -->
        <Border x:Name="Sidebar" DockPanel.Dock="Left" Width="200"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,16,12,14">
                    <Border Width="30" Height="30" CornerRadius="6" Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="F" Foreground="White" FontWeight="Bold" FontSize="14"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel x:Name="BrandText" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Frubber" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="POS" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>

                <DockPanel DockPanel.Dock="Bottom" Margin="12,0,12,12">
                    <TextBlock DockPanel.Dock="Bottom" Text="v1.0 · Modo fuera de línea"
                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" Margin="4,4,0,0"/>
                    <Button DockPanel.Dock="Bottom" Content="Cerrar sesión" Command="{Binding SignOutCommand}"
                            Style="{DynamicResource SecondaryButton}" HorizontalContentAlignment="Left"
                            MinHeight="36" FontSize="13"
                            AutomationProperties.Name="Cerrar sesión"/>
                    <!-- El rol abraza su texto (fila compacta, no estirada). -->
                    <Border x:Name="RoleBadge" Style="{DynamicResource PillMint}" DockPanel.Dock="Bottom"
                            Padding="12,4" Margin="0,0,0,10" HorizontalAlignment="Left"
                            AutomationProperties.Name="Rol del usuario">
                        <TextBlock Text="{Binding RoleBadgeText}" Style="{DynamicResource PillText}"/>
                    </Border>
                </DockPanel>

                <ListBox x:Name="MenuList"
                         ItemsSource="{Binding MenuItems}"
                         SelectedItem="{Binding SelectedEntry}"
                         Margin="8,0,8,0"
                         AutomationProperties.Name="Menú principal">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="26" CornerRadius="5"
                                        Background="{DynamicResource MintBrush}">
                                    <TextBlock Text="{Binding Icon}" FontSize="12" FontWeight="Bold"
                                               Foreground="{DynamicResource PrimaryBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ===== Contenido ===== -->
        <DockPanel Background="{DynamicResource AppBackground}">
            <!-- Encabezado: título + pastillas de estado compactas + chip de usuario -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="24,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Style="{DynamicResource PillMint}" Margin="4,0" Padding="10,3"
                                Visibility="{Binding CashPillVisible, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Estado de caja">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}"
                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="Caja abierta" Foreground="{DynamicResource SuccessBrush}"
                                           FontSize="12" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Border>
                        <Border x:Name="LicensePill" Margin="4,0" Padding="10,3"
                                CornerRadius="999" Background="{DynamicResource MintBrush}"
                                Visibility="{Binding LicenseBadgeVisible, Converter={StaticResource BoolToVis}}"
                                AutomationProperties.Name="Estado de licencia">
                            <TextBlock x:Name="LicensePillText" Text="{Binding LicenseBadgeText}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource PillText}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding LicenseBadgeIsTrial}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource TrialTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource PillMint}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LicenseBadgeIsTrial}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource TrialBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Border Style="{DynamicResource AvatarCircle}" Width="32" Height="32">
                                <TextBlock Text="{Binding UserInitials}" Foreground="{DynamicResource PrimaryBrush}"
                                           FontWeight="Bold" FontSize="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding RoleBadgeText}" FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{Binding PageTitle}" Style="{DynamicResource PageTitle}" VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <DockPanel Margin="24">
                <TextBlock DockPanel.Dock="Top" Text="{Binding PageDescription}" Margin="0,0,0,2">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource PageSubtitle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding PageDescription}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <ContentControl DockPanel.Dock="Top" Content="{Binding CurrentPage}" Margin="0,10,0,0"/>
            </DockPanel>
        </DockPanel>
    </DockPanel>
</Window>
