<Window x:Class="FrubberPOS.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS" Height="600" Width="900" MinWidth="1180" MinHeight="640"
        WindowState="Maximized" WindowStartupLocation="CenterScreen"
        KeyDown="OnKeyDown">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12,6">
            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" VerticalAlignment="Center"/>
            <Button Content="Cerrar sesión" Command="{Binding SignOutCommand}" Margin="16,0,0,0" Padding="12,4"/>
        </StackPanel>
        <ListBox DockPanel.Dock="Left" Width="170" Margin="12,0,0,12"
                 ItemsSource="{Binding MenuItems}" DisplayMemberPath="Title"
                 SelectedItem="{Binding SelectedEntry}"
                 AutomationProperties.Name="Menú principal"/>
        <DockPanel Margin="24">
            <TextBlock DockPanel.Dock="Top" Text="{Binding PageTitle}" FontSize="24" FontWeight="Bold"/>
            <TextBlock DockPanel.Dock="Top" Text="{Binding PageDescription}" Margin="0,8,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding PageDescription}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ContentControl DockPanel.Dock="Top" Content="{Binding CurrentPage}" Margin="0,12,0,0"/>
        </DockPanel>
    </DockPanel>
</Window>
