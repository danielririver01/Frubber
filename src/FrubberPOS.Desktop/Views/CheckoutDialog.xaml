<Window x:Class="FrubberPOS.Desktop.Views.CheckoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vw="clr-namespace:FrubberPOS.Desktop.Views"
        Title="Frubber POS — Cobrar venta" Height="340" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock Text="Cobrar venta" FontSize="20" FontWeight="Bold"/>
        <DockPanel Margin="0,12,0,6">
            <TextBlock Text="Subtotal:" Width="160"/>
            <TextBlock Text="{Binding SubtotalText}" FontWeight="Bold"/>
        </DockPanel>

        <TextBlock Text="Descuento (pesos, 0 al subtotal):" Margin="0,0,0,4"/>
        <TextBox x:Name="DiscountBox" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="14" Padding="6" AutomationProperties.Name="Descuento"/>

        <DockPanel Margin="0,10,0,6">
            <TextBlock Text="Total:" Width="160" FontWeight="Bold" FontSize="16"/>
            <TextBlock Text="{Binding TotalText}" FontWeight="Bold" FontSize="16"/>
        </DockPanel>

        <StackPanel Orientation="Horizontal" Margin="0,6,0,6">
            <RadioButton Content="Efectivo" IsChecked="{Binding IsCash}" GroupName="Payment"
                         Padding="10,4" AutomationProperties.Name="Pago en efectivo"/>
            <RadioButton Content="Transferencia" IsChecked="{Binding IsTransfer}" GroupName="Payment"
                         Padding="10,4" AutomationProperties.Name="Pago por transferencia"/>
        </StackPanel>

        <StackPanel Visibility="{Binding ShowCashFields, Converter={StaticResource BoolToVis}}">
            <TextBlock Text="Efectivo recibido:" Margin="0,0,0,4"/>
            <TextBox x:Name="ReceivedBox" Text="{Binding ReceivedText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" Padding="6" AutomationProperties.Name="Efectivo recibido"/>
            <DockPanel Margin="0,8,0,0">
                <TextBlock Text="Cambio:" Width="160"/>
                <TextBlock Text="{Binding ChangeText}" FontWeight="Bold"/>
            </DockPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancelar" Click="OnCancel" Padding="12,6" Margin="0,0,8,0" IsCancel="True"/>
            <Button Content="Confirmar" Command="{Binding ConfirmCommand}" Padding="12,6"
                    FontWeight="Bold" IsDefault="True"
                    AutomationProperties.Name="Confirmar cobro"/>
        </StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
