<Window x:Class="FrubberPOS.Desktop.Views.CheckoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        MouseLeftButtonDown="OnDragMove">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>
    <Border Style="{DynamicResource DialogCard}" Margin="16">
        <StackPanel>
            <DockPanel>
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="✕" Click="OnCancel"
                        Style="{DynamicResource SecondaryButton}" MinHeight="32" MinWidth="32" Padding="4"
                        AutomationProperties.Name="Cerrar cobro"/>
                <TextBlock Text="Cobrar venta" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Revise el descuento y registre el medio de pago." Style="{DynamicResource PageSubtitle}"
                       Margin="0,2,0,14"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Resumen -->
                <StackPanel>
                    <TextBlock Text="Resumen" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Subtotal" Style="{DynamicResource PageSubtitle}"/>
                        <TextBlock Text="{Binding SubtotalText}" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="Descuento (pesos, 0 al subtotal):" Style="{DynamicResource PageSubtitle}" Margin="0,8,0,4"/>
                    <TextBox x:Name="DiscountBox" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Descuento"/>
                    <Border Background="{DynamicResource MintBrush}" CornerRadius="8" Padding="12,10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding TotalText}" FontWeight="Bold" FontSize="26"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       AutomationProperties.Name="Total a cobrar"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Pago -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="Medio de pago" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryTextBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton Content="Efectivo" IsChecked="{Binding IsCash}" GroupName="Payment"
                                     Padding="10,4" FontWeight="SemiBold" AutomationProperties.Name="Pago en efectivo"/>
                        <RadioButton Content="Transferencia" IsChecked="{Binding IsTransfer}" GroupName="Payment"
                                     Padding="10,4" Margin="12,0,0,0" FontWeight="SemiBold"
                                     AutomationProperties.Name="Pago por transferencia"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowCashFields, Converter={StaticResource BoolToVis}}" Margin="0,10,0,0">
                        <TextBlock Text="Efectivo recibido:" Style="{DynamicResource PageSubtitle}"/>
                        <TextBox x:Name="ReceivedBox" Text="{Binding ReceivedText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Efectivo recibido"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock Text="Cambio:" Style="{DynamicResource PageSubtitle}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding ChangeText}" FontWeight="Bold" FontSize="18" Margin="8,0,0,0"
                                       Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Style="{DynamicResource ErrorText}" Margin="0,12,0,0"/>

            <DockPanel Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="Confirmar  F9" Command="{Binding ConfirmCommand}"
                        IsDefault="True" Style="{DynamicResource BigPrimaryButton}" MinHeight="44"
                        AutomationProperties.Name="Confirmar cobro"/>
                <Button Content="Cancelar" Click="OnCancel" IsCancel="True"
                        Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
