<Window x:Class="FrubberPOS.Desktop.Views.CheckoutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        MouseLeftButtonDown="OnDragMove">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="PayChip" TargetType="RadioButton">
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" BorderThickness="1"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MintBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Style="{DynamicResource DialogCard}" Margin="16">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Click="OnCancel"
                        Style="{DynamicResource SecondaryButton}" MinHeight="32" MinWidth="32" Padding="4"
                        AutomationProperties.Name="Cerrar cobro"/>
                <TextBlock Text="Cobrar venta" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Revise el descuento y registre el medio de pago." Style="{DynamicResource PageSubtitle}"
                       Margin="0,2,0,14"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- RESUMEN -->
                <StackPanel>
                    <TextBlock Text="RESUMEN" Style="{DynamicResource ColumnCaption}"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock Text="Subtotal" Style="{DynamicResource PageSubtitle}"/>
                        <TextBlock Text="{Binding SubtotalText}" Style="{DynamicResource NumericText}"
                                   HorizontalAlignment="Right"/>
                    </DockPanel>
                    <TextBlock Text="Descuento (pesos, 0 al subtotal):" Style="{DynamicResource PageSubtitle}" Margin="0,8,0,4"/>
                    <TextBox x:Name="DiscountBox" Text="{Binding DiscountText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Descuento"/>
                    <Border Background="{DynamicResource MintHoverBrush}" CornerRadius="8" Padding="14,10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="TOTAL" Style="{DynamicResource ColumnCaption}"
                                       Foreground="{DynamicResource PrimaryBrush}"/>
                            <TextBlock Text="{Binding TotalText}" FontWeight="ExtraBold" FontSize="26"
                                       Foreground="{DynamicResource PrimaryBrush}"
                                       AutomationProperties.Name="Total a cobrar"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- MEDIO DE PAGO -->
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <TextBlock Text="MEDIO DE PAGO" Style="{DynamicResource ColumnCaption}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <RadioButton Content="Efectivo" IsChecked="{Binding IsCash}" GroupName="Payment"
                                     Style="{DynamicResource PayChip}" AutomationProperties.Name="Pago en efectivo"/>
                        <RadioButton Content="Transferencia" IsChecked="{Binding IsTransfer}" GroupName="Payment"
                                     Style="{DynamicResource PayChip}" Margin="8,0,0,0"
                                     AutomationProperties.Name="Pago por transferencia"/>
                    </StackPanel>
                    <StackPanel Visibility="{Binding ShowCashFields, Converter={StaticResource BoolToVis}}" Margin="0,12,0,0">
                        <TextBlock Text="EFECTIVO RECIBIDO" Style="{DynamicResource ColumnCaption}" Margin="0,0,0,4"/>
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{DynamicResource ShortcutChip}" Padding="8,4" Margin="6,0,0,0">
                                <TextBlock Text="COP" Style="{DynamicResource ShortcutText}" FontWeight="SemiBold"/>
                            </Border>
                            <TextBox x:Name="ReceivedBox" Text="{Binding ReceivedText, UpdateSourceTrigger=PropertyChanged}" MinHeight="44"
                                     AutomationProperties.Name="Efectivo recibido"/>
                        </DockPanel>
                        <Border Background="{DynamicResource SuccessSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="CAMBIO" Style="{DynamicResource ColumnCaption}"
                                           Foreground="{DynamicResource SuccessBrush}"/>
                                <TextBlock Text="{Binding ChangeText}" FontWeight="ExtraBold" FontSize="22"
                                           Foreground="{DynamicResource SuccessBrush}"
                                           AutomationProperties.Name="Cambio"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <TextBlock Text="{Binding ErrorMessage}" Style="{DynamicResource ErrorText}" Margin="0,10,0,0"/>
            <TextBlock Text="F9 confirma · Esc vuelve sin perder la venta" Style="{DynamicResource PageSubtitle}"
                       Foreground="{DynamicResource MutedTextBrush}" FontSize="12" Margin="0,10,0,0"/>

            <DockPanel Margin="0,8,0,0">
                <Button DockPanel.Dock="Right" Content="Confirmar  F9" Command="{Binding ConfirmCommand}"
                        IsDefault="True" Style="{DynamicResource BigPrimaryButton}" MinHeight="44"
                        AutomationProperties.Name="Confirmar cobro"/>
                <Button Content="Cancelar" Click="OnCancel" IsCancel="True"
                        Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
