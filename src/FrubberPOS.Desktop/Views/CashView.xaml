<UserControl x:Class="FrubberPOS.Desktop.Views.CashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vw="clr-namespace:FrubberPOS.Desktop.Views">
    <UserControl.Resources>
        <vw:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel>
        <!-- Estado abierto: resumen de lectura (§11.2, DESIGN.md Caja/Arqueo) -->
        <StackPanel Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Cerrar caja" Command="{Binding CloseCommand}"
                        Style="{DynamicResource SecondaryButton}" FontWeight="SemiBold"
                        Foreground="{DynamicResource ErrorBrush}" MinHeight="36"
                        AutomationProperties.Name="Cerrar caja (irreversible)"/>
                <TextBlock Text="Caja abierta" Style="{DynamicResource PageTitle}" VerticalAlignment="Center"/>
            </DockPanel>

            <!-- Fila de sesión -->
            <Border Style="{DynamicResource Card}" Padding="16,10" Margin="0,8,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,24,0">
                        <TextBlock Text="SESIÓN ACTUAL" Style="{DynamicResource ColumnCaption}"/>
                        <Border Style="{DynamicResource PillMint}" HorizontalAlignment="Left" Margin="0,4,0,0">
                            <TextBlock Text="Abierta" Foreground="{DynamicResource SuccessBrush}"
                                       Style="{DynamicResource PillText}" AutomationProperties.Name="Estado de caja"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="APERTURA" Style="{DynamicResource ColumnCaption}"/>
                        <TextBlock Text="{Binding OpenedAtText}" Margin="0,4,0,0" Style="{DynamicResource NumericText}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="USUARIO" Style="{DynamicResource ColumnCaption}"/>
                        <TextBlock Text="{Binding OpenedByText}" Margin="0,4,0,0" FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3">
                        <TextBlock Text="SALDO INICIAL" Style="{DynamicResource ColumnCaption}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding SessionOpeningBalanceDisplay}" Style="{DynamicResource NumericText}"
                                       VerticalAlignment="Center"/>
                            <Button Content="Corregir" Command="{Binding CorrectBalanceCommand}" Margin="10,0,0,0"
                                    Padding="10,0" MinHeight="24" FontSize="12" Style="{DynamicResource SecondaryButton}"
                                    Visibility="{Binding ShowCorrectBalance, Converter={StaticResource BoolToVis}}"
                                    ToolTip="Corregir saldo inicial (solo antes de la primera venta)"
                                    AutomationProperties.Name="Corregir saldo inicial"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- KPI cards con barra superior (DESIGN.md §4) -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{DynamicResource KpiCard}" Margin="0,0,6,0">
                    <StackPanel>
                        <Border Height="3" Background="{DynamicResource PrimaryBrush}" CornerRadius="3,3,0,0"/>
                        <StackPanel Margin="14,10">
                            <TextBlock Text="Ventas netas" Style="{DynamicResource PageSubtitle}"/>
                            <TextBlock Text="{Binding NetSalesText}" Style="{DynamicResource KpiMetric}" Margin="0,4,0,0"/>
                            <TextBlock Text="{Binding SaleCountText}" Foreground="{DynamicResource MutedTextBrush}" FontSize="12"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource KpiCard}" Margin="3,0">
                    <StackPanel>
                        <Border Height="3" Background="{DynamicResource SuccessBrush}" CornerRadius="3,3,0,0"/>
                        <StackPanel Margin="14,10">
                            <TextBlock Text="Efectivo" Style="{DynamicResource PageSubtitle}"/>
                            <TextBlock Text="{Binding CashSalesText}" Style="{DynamicResource KpiMetric}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource KpiCard}" Margin="3,0">
                    <StackPanel>
                        <Border Height="3" Background="#2563EB" CornerRadius="3,3,0,0"/>
                        <StackPanel Margin="14,10">
                            <TextBlock Text="Transferencia" Style="{DynamicResource PageSubtitle}"/>
                            <TextBlock Text="{Binding TransferSalesText}" Style="{DynamicResource KpiMetric}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource KpiCard}" Margin="6,0,0,0">
                    <StackPanel>
                        <Border Height="3" Background="{DynamicResource WarningBrush}" CornerRadius="3,3,0,0"/>
                        <StackPanel Margin="14,10">
                            <TextBlock Text="Descuentos" Style="{DynamicResource PageSubtitle}"/>
                            <TextBlock Text="{Binding DiscountText}" Style="{DynamicResource KpiMetric}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Efectivo esperado con desglose -->
            <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="EFECTIVO ESPERADO" Style="{DynamicResource ColumnCaption}"/>
                        <TextBlock Text="{Binding ExpectedCashText}" Style="{DynamicResource DisplayTotal}"
                                   Margin="0,4,0,0" Foreground="{DynamicResource SuccessBrush}"
                                   AutomationProperties.Name="Efectivo esperado"/>
                        <TextBlock Text="Saldo inicial + ventas vigentes en efectivo" Style="{DynamicResource PageSubtitle}"
                                   FontSize="12" Margin="0,2,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <DockPanel Width="260" Margin="0,2,0,0">
                            <TextBlock Text="Saldo inicial" Style="{DynamicResource PageSubtitle}"/>
                            <TextBlock Text="{Binding SessionOpeningBalanceDisplay}" Style="{DynamicResource NumericText}"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Width="260" Margin="0,2,0,0">
                            <TextBlock Text="Ventas en efectivo" Style="{DynamicResource PageSubtitle}"/>
                            <TextBlock Text="{Binding CashSalesText}" Style="{DynamicResource NumericText}"
                                       HorizontalAlignment="Right"/>
                        </DockPanel>
                        <DockPanel Width="260">
                            <TextBlock Text="Descuentos del día" Style="{DynamicResource PageSubtitle}"/>
                            <TextBlock Text="{Binding DiscountText}" Style="{DynamicResource NumericText}"
                                       Foreground="{DynamicResource WarningBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Background="{DynamicResource WarnSoftBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1"
                    CornerRadius="6" Padding="12,8" Margin="0,0,0,0">
                <TextBlock Text="Al cerrar se conservará el resumen histórico y la venta quedará bloqueada hasta una nueva apertura."
                           Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </Border>
        </StackPanel>

        <!-- Estado cerrado: formulario de apertura (§11.1) -->
        <Border Style="{DynamicResource Card}" MaxWidth="420"
                Visibility="{Binding IsOpen, Converter={StaticResource InverseBoolToVis}}"
                HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Caja cerrada" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Ingrese el saldo inicial para abrir la caja:" Margin="0,8,0,6"
                           Style="{DynamicResource PageSubtitle}"/>
                <TextBox Text="{Binding OpeningBalanceText, UpdateSourceTrigger=PropertyChanged}"
                         Width="180" HorizontalAlignment="Left"
                         AutomationProperties.Name="Saldo inicial"/>
                <Button Content="Abrir caja" Command="{Binding OpenCommand}"
                        HorizontalAlignment="Left" Margin="0,12,0,0" IsDefault="True"
                        AutomationProperties.Name="Abrir caja"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding ErrorMessage}" Style="{DynamicResource ErrorText}" Margin="0,6,0,0"/>
    </StackPanel>
</UserControl>
