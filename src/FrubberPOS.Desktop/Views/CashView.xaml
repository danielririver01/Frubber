<UserControl x:Class="FrubberPOS.Desktop.Views.CashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vw="clr-namespace:FrubberPOS.Desktop.Views">
    <UserControl.Resources>
        <vw:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Caja" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
            <Border Margin="12,0,0,0" Padding="10,3" CornerRadius="12" Background="#DCFCE7">
                <TextBlock Text="{Binding StateText}" FontWeight="Bold" Foreground="#166534"
                           AutomationProperties.Name="Estado de caja"/>
            </Border>
        </StackPanel>

        <!-- Estado abierto: resumen de lectura (§11.2) -->
        <StackPanel Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Apertura:" Width="140"/>
                <TextBlock Text="{Binding OpenedByText}" FontWeight="Bold"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Saldo inicial:" Width="140"/>
                <TextBlock Text="{Binding SessionOpeningBalanceDisplay}" FontWeight="Bold"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Ventas en efectivo:" Width="140"/>
                <TextBlock Text="{Binding CashSalesText}" FontWeight="Bold"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Ventas transferencia:" Width="140"/>
                <TextBlock Text="{Binding TransferSalesText}" FontWeight="Bold"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Descuentos:" Width="140"/>
                <TextBlock Text="{Binding DiscountText}" FontWeight="Bold"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Ventas netas:" Width="140"/>
                <TextBlock Text="{Binding NetSalesText}" FontWeight="Bold"/>
            </DockPanel>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Cantidad de ventas:" Width="140"/>
                <TextBlock Text="{Binding SaleCountText}" FontWeight="Bold"/>
            </DockPanel>
            <Separator Margin="0,8"/>
            <DockPanel Margin="0,0,0,6">
                <TextBlock Text="Efectivo esperado:" Width="140" FontWeight="Bold"/>
                <TextBlock Text="{Binding ExpectedCashText}" FontWeight="Bold" Foreground="#166534"/>
            </DockPanel>
            <Button Content="Cerrar caja" Command="{Binding CloseCommand}" Padding="12,6"
                    HorizontalAlignment="Left" Margin="0,10,0,0" FontWeight="Bold"
                    AutomationProperties.Name="Cerrar caja (irreversible)"/>
        </StackPanel>

        <!-- Estado cerrado: formulario de apertura (§11.1) -->
        <StackPanel Visibility="{Binding IsOpen, Converter={StaticResource InverseBoolToVis}}">
            <TextBlock Text="Sin caja. Ingrese el saldo inicial para abrir:" Margin="0,0,0,6"/>
            <TextBox Text="{Binding OpeningBalanceText, UpdateSourceTrigger=PropertyChanged}"
                     FontSize="14" Padding="6" Width="180" HorizontalAlignment="Left"
                     AutomationProperties.Name="Saldo inicial"/>
            <Button Content="Abrir caja" Command="{Binding OpenCommand}" Padding="12,6"
                    HorizontalAlignment="Left" Margin="0,10,0,0" FontWeight="Bold"
                    IsDefault="True" AutomationProperties.Name="Abrir caja"/>
        </StackPanel>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
