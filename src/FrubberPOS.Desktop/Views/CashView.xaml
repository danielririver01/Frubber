<UserControl x:Class="FrubberPOS.Desktop.Views.CashView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vw="clr-namespace:FrubberPOS.Desktop.Views">
    <UserControl.Resources>
        <vw:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock Text="Caja" Style="{DynamicResource PageTitle}" VerticalAlignment="Center"/>
            <Border Margin="12,0,0,0" Style="{DynamicResource PillMint}">
                <TextBlock Text="{Binding StateText}" Style="{DynamicResource PillText}"
                           AutomationProperties.Name="Estado de caja"/>
            </Border>
        </StackPanel>

        <!-- Estado abierto: resumen de lectura (§11.2) -->
        <StackPanel Visibility="{Binding IsOpen, Converter={StaticResource BoolToVis}}">
            <!-- KPI cards (fig. 5) -->
            <UniformGrid Columns="4" Margin="0,0,0,12">
                <Border Style="{DynamicResource KpiCard}" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Background="{DynamicResource PrimaryBrush}" CornerRadius="2"/>
                        <StackPanel Margin="12,10" >
                            <TextBlock Text="Ventas netas" Style="{DynamicResource PageSubtitle}"/>
                            <TextBlock Text="{Binding NetSalesText}" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="{Binding SaleCountText, StringFormat='{}{0} ventas'}"
                                       Style="{DynamicResource PageSubtitle}" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource KpiCard}" Margin="3,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Background="{DynamicResource SuccessBrush}" CornerRadius="2"/>
                        <StackPanel Margin="12,10">
                            <TextBlock Text="Efectivo" Style="{DynamicResource PageSubtitle}"/>
                            <TextBlock Text="{Binding CashSalesText}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource KpiCard}" Margin="3,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Background="#2563EB" CornerRadius="2"/>
                        <StackPanel Margin="12,10">
                            <TextBlock Text="Transferencia" Style="{DynamicResource PageSubtitle}"/>
                            <TextBlock Text="{Binding TransferSalesText}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource KpiCard}" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="4" Background="{DynamicResource WarningBrush}" CornerRadius="2"/>
                        <StackPanel Margin="12,10">
                            <TextBlock Text="Descuentos" Style="{DynamicResource PageSubtitle}"/>
                            <TextBlock Text="{Binding DiscountText}" FontSize="20" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{DynamicResource Card}" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Text="Apertura:" Width="150" Style="{DynamicResource PageSubtitle}"/>
                        <TextBlock Text="{Binding OpenedByText}" FontWeight="SemiBold"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Saldo inicial:" Width="150" Style="{DynamicResource PageSubtitle}"/>
                        <TextBlock Text="{Binding SessionOpeningBalanceDisplay}" FontWeight="SemiBold"/>
                        <Button Content="Corregir saldo" Command="{Binding CorrectBalanceCommand}" Margin="10,0,0,0"
                                Padding="10,2" MinHeight="28" FontSize="12" Style="{DynamicResource SecondaryButton}"
                                Visibility="{Binding ShowCorrectBalance, Converter={StaticResource BoolToVis}}"
                                ToolTip="Solo antes de la primera venta (JHO-61)"
                                AutomationProperties.Name="Corregir saldo inicial"/>
                    </DockPanel>
                    <Separator Margin="0,4" Background="{DynamicResource BorderBrush}"/>
                    <DockPanel Margin="0,10,0,0">
                        <TextBlock Text="EFECTIVO ESPERADO" FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ExpectedCashText}"
                                   FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Right"
                                   AutomationProperties.Name="Efectivo esperado"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource WarnSoftBrush}" CornerRadius="8" Padding="12,8"
                    Margin="0,0,0,12">
                <TextBlock Text="Al cerrar se conservará el resumen histórico y la venta quedará bloqueada hasta una nueva apertura."
                           Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontWeight="SemiBold"/>
            </Border>

            <Button Content="Cerrar caja" Command="{Binding CloseCommand}" Padding="16,8"
                    HorizontalAlignment="Right" FontWeight="Bold" Style="{DynamicResource SecondaryButton}"
                    AutomationProperties.Name="Cerrar caja (irreversible)"/>
        </StackPanel>

        <!-- Estado cerrado: formulario de apertura (§11.1) -->
        <Border Style="{DynamicResource Card}" MaxWidth="420"
                Visibility="{Binding IsOpen, Converter={StaticResource InverseBoolToVis}}"
                HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Caja cerrada" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="Ingrese el saldo inicial para abrir la caja:" Margin="0,8,0,6"
                           Style="{DynamicResource PageSubtitle}"/>
                <TextBox Text="{Binding OpeningBalanceText, UpdateSourceTrigger=PropertyChanged}"
                         Width="180" HorizontalAlignment="Left"
                         AutomationProperties.Name="Saldo inicial"/>
                <Button Content="Abrir caja" Command="{Binding OpenCommand}"
                        HorizontalAlignment="Left" Margin="0,12,0,0" IsDefault="True"
                        AutomationProperties.Name="Abrir caja"/>
            </StackPanel>
        </Border>

        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding ErrorMessage}" Style="{DynamicResource ErrorText}" Margin="0,10,0,0"/>
    </StackPanel>
</UserControl>
