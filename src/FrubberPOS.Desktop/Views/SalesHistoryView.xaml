<UserControl x:Class="FrubberPOS.Desktop.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- JHO-75: mismo patrón JHO-74 de ProductsView — DataGridCell.Padding
             no se aplica en WPF; el margen banda [col+10..col-10] alinea
             cabecera y valor. -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,10,0"/>
        </Style>
        <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="HeaderRight" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource ColumnHeaderBase}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Top" Style="{DynamicResource Card}" Padding="12,10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,6,0" Style="{DynamicResource PageSubtitle}"/>
                <TextBox x:Name="FromBox" Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}"
                         Width="110" AutomationProperties.Name="Fecha Desde (dd/MM/aaaa)"/>
                <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="12,0,6,0" Style="{DynamicResource PageSubtitle}"/>
                <TextBox x:Name="ToBox" Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}"
                         Width="110" AutomationProperties.Name="Fecha Hasta (dd/MM/aaaa)"/>
                <Button Content="Buscar" Command="{Binding SearchCommand}" Margin="12,0,8,0"
                        FontWeight="Bold" AutomationProperties.Name="Buscar ventas"/>
                <Button Content="Limpiar" Command="{Binding ClearFilterCommand}" Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButton}" AutomationProperties.Name="Limpiar fechas del filtro"/>
                <Button Content="Anterior" Command="{Binding PreviousPageCommand}" Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButton}" AutomationProperties.Name="Página anterior"/>
                <Button Content="Siguiente" Command="{Binding NextPageCommand}" Margin="0,0,8,0"
                        Style="{DynamicResource SecondaryButton}" AutomationProperties.Name="Página siguiente"/>
                <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" Style="{DynamicResource PageSubtitle}"/>
                <Button Content="Ver detalle" Command="{Binding OpenDetailCommand}"
                        HorizontalAlignment="Right" Style="{DynamicResource SecondaryButton}"
                        AutomationProperties.Name="Ver detalle de la venta"/>
            </StackPanel>
        </Border>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{DynamicResource ErrorText}"
                   Margin="0,6,0,0"/>

        <Border Style="{DynamicResource Card}" Padding="0,0,0,8">
            <Grid>
                <!-- JHO-75: estado vacío contextual (sin ventas / sin ventas en el
                     rango) siguiendo el patrón .empty del prototipo historial. -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,32"
                            Visibility="{Binding EmptyVisible, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding EmptyTitle}" FontSize="16" FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               HorizontalAlignment="Center" AutomationProperties.Name="Título del estado vacío"/>
                    <TextBlock Text="{Binding EmptySub}" FontSize="13" Margin="0,6,0,0" MaxWidth="380" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSubBrush}"
                               HorizontalAlignment="Center" AutomationProperties.Name="Descripción del estado vacío"/>
                    <Button Content="Limpiar fechas" Command="{Binding ClearFilterCommand}"
                            Margin="0,16,0,0" Style="{DynamicResource SecondaryButton}"
                            Visibility="{Binding EmptyCtaVisible, Converter={StaticResource BoolToVis}}"
                            AutomationProperties.Name="Limpiar fechas del filtro"/>
                </StackPanel>

                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          MouseDoubleClick="OnRowDoubleClick"
                          AutomationProperties.Name="Tabla del historial de ventas"
                          Visibility="{Binding RowsVisible, Converter={StaticResource BoolToVis}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="N°" Binding="{Binding NumberText}" Width="90"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Fecha y hora" Binding="{Binding MomentText}" Width="140"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Cajero" Binding="{Binding CashierName}" Width="*"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Medio" Binding="{Binding PaymentText}" Width="110"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Binding="{Binding TotalText}" Width="110"
                                            HeaderStyle="{StaticResource HeaderRight}"
                                            ElementStyle="{StaticResource CellTextRight}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Total" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Estado" Binding="{Binding StatusText}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                                    <Setter Property="Foreground" Value="{Binding StatusBrush}"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
