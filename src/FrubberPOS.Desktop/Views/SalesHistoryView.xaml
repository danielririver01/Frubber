<UserControl x:Class="FrubberPOS.Desktop.Views.SalesHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Desde" VerticalAlignment="Center" Margin="0,0,6,0"/>
            <TextBox x:Name="FromBox" Text="{Binding FromText, UpdateSourceTrigger=PropertyChanged}"
                     Width="100" Padding="6,3" AutomationProperties.Name="Fecha Desde (dd/MM/aaaa)"/>
            <TextBlock Text="Hasta" VerticalAlignment="Center" Margin="12,0,6,0"/>
            <TextBox x:Name="ToBox" Text="{Binding ToText, UpdateSourceTrigger=PropertyChanged}"
                     Width="100" Padding="6,3" AutomationProperties.Name="Fecha Hasta (dd/MM/aaaa)"/>
            <Button Content="Buscar" Command="{Binding SearchCommand}" Padding="14,5" Margin="12,0,8,0"
                    FontWeight="Bold" AutomationProperties.Name="Buscar ventas"/>
            <Button Content="Anterior" Command="{Binding PreviousPageCommand}" Padding="12,5" Margin="0,0,8,0"
                    AutomationProperties.Name="Página anterior"/>
            <Button Content="Siguiente" Command="{Binding NextPageCommand}" Padding="12,5" Margin="0,0,8,0"
                    AutomationProperties.Name="Página siguiente"/>
            <TextBlock Text="{Binding SummaryText}" VerticalAlignment="Center" Foreground="#6B7280"/>
            <Button Content="Ver detalle" Command="{Binding OpenDetailCommand}" Padding="14,5"
                    HorizontalAlignment="Right" AutomationProperties.Name="Ver detalle de la venta"/>
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Foreground="#B91C1C"
                   Margin="0,6,0,0" TextWrapping="Wrap"/>

        <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                  AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                  CanUserAddRows="False" HeadersVisibility="Column" RowHeight="30"
                  MouseDoubleClick="OnRowDoubleClick"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="N°" Binding="{Binding NumberText}" Width="90"/>
                <DataGridTextColumn Header="Fecha y hora" Binding="{Binding MomentText}" Width="140"/>
                <DataGridTextColumn Header="Cajero" Binding="{Binding CashierName}" Width="140"/>
                <DataGridTextColumn Header="Medio" Binding="{Binding PaymentText}" Width="110"/>
                <DataGridTextColumn Header="Total" Binding="{Binding TotalText}" Width="110">
                    <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock">
                            <Setter Property="HorizontalAlignment" Value="Right"/>
                        </Style>
                    </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTemplateColumn Header="Estado" Width="110">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}" FontWeight="Bold"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>
