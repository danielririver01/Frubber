<Window x:Class="FrubberPOS.Desktop.Views.CorrectOpeningBalanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        MouseLeftButtonDown="OnDragMove">
    <Border Style="{DynamicResource DialogCard}" Margin="16">
        <StackPanel>
            <TextBlock Text="Corregir saldo inicial" FontSize="20" FontWeight="Bold"/>
            <TextBlock x:Name="HintText" Style="{DynamicResource PageSubtitle}" TextWrapping="Wrap" Margin="0,6,0,10"/>
            <TextBox x:Name="AmountBox" FontSize="16" FontWeight="SemiBold" MinHeight="44"
                     AutomationProperties.Name="Saldo inicial corregido"/>
            <TextBlock x:Name="ErrorText" Style="{DynamicResource ErrorText}" Margin="0,8,0,0"/>
            <DockPanel Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="Corregir" Click="OnConfirm" IsDefault="True" MinWidth="120"
                        AutomationProperties.Name="Corregir saldo"/>
                <Button Content="Cancelar" Click="OnCancel" IsCancel="True" HorizontalAlignment="Left"
                        Style="{DynamicResource SecondaryButton}"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
