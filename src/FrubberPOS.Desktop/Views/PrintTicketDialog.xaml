<Window x:Class="FrubberPOS.Desktop.Views.PrintTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS — Imprimir ticket" Height="230" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Imprimir ticket" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Seleccione la impresora de Windows o cancele para no imprimir." Margin="0,12,0,6" TextWrapping="Wrap"/>
        <ComboBox x:Name="PrinterCombo" FontSize="14" Padding="6" AutomationProperties.Name="Impresora"/>
        <TextBlock x:Name="NoPrintersText" Text="No hay impresoras instaladas en este equipo."
                   Foreground="#B91C1C" Margin="0,6,0,0" Visibility="Collapsed"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="OnCancel" Padding="12,6" Margin="0,0,8,0" IsCancel="True"
                    AutomationProperties.Name="Cancelar impresión"/>
            <Button x:Name="PrintButton" Content="Imprimir" Click="OnPrint" Padding="12,6"
                    FontWeight="Bold" IsDefault="True" AutomationProperties.Name="Imprimir"/>
        </StackPanel>
    </StackPanel>
</Window>
