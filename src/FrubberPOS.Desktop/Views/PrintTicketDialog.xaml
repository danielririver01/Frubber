<Window x:Class="FrubberPOS.Desktop.Views.PrintTicketDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        MouseLeftButtonDown="OnDragMove">
    <Border Style="{DynamicResource DialogCard}" Margin="16">
        <StackPanel>
            <TextBlock Text="Imprimir ticket" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="Seleccione la impresora de Windows o cancele para no imprimir."
                       Style="{DynamicResource PageSubtitle}" TextWrapping="Wrap" Margin="0,6,0,10"/>
            <ComboBox x:Name="PrinterCombo" AutomationProperties.Name="Impresora"/>
            <Border x:Name="NoPrintersText" Background="{DynamicResource ErrorSoftBrush}" CornerRadius="8"
                    Padding="10,6" Margin="0,8,0,0" Visibility="Collapsed">
                <TextBlock Text="No hay impresoras instaladas en este equipo."
                           Foreground="{DynamicResource ErrorBrush}"/>
            </Border>
            <DockPanel Margin="0,16,0,0">
                <Button x:Name="PrintButton" DockPanel.Dock="Right" Content="Imprimir" Click="OnPrint"
                        IsDefault="True" MinWidth="110" AutomationProperties.Name="Imprimir"/>
                <Button Content="Cancelar" Click="OnCancel" IsCancel="True"
                        Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left"
                        AutomationProperties.Name="Cancelar impresión"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
