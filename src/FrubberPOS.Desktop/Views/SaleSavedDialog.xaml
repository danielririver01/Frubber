<Window x:Class="FrubberPOS.Desktop.Views.SaleSavedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        MouseLeftButtonDown="OnDragMove">
    <Border Style="{DynamicResource DialogCard}" Margin="16">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Style="{DynamicResource AvatarCircle}" Width="44" Height="44">
                    <TextBlock Text="✓" Foreground="{DynamicResource SuccessBrush}" FontSize="20"
                               FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Venta guardada" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource SuccessBrush}"/>
                    <TextBlock Text="La impresión del ticket es opcional." Style="{DynamicResource PageSubtitle}"/>
                </StackPanel>
            </StackPanel>

            <Border Style="{DynamicResource Card}" CornerRadius="10" Margin="0,16,0,0" Padding="16,12">
                <StackPanel>
                    <TextBlock x:Name="SaleNumberText" FontSize="24" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}" AutomationProperties.Name="Número de venta"/>
                    <TextBlock x:Name="TotalText" FontSize="18" FontWeight="Bold" Margin="0,4,0,0"
                               AutomationProperties.Name="Total"/>
                    <TextBlock x:Name="PaymentText" Margin="0,2,0,0" Style="{DynamicResource PageSubtitle}"
                               AutomationProperties.Name="Medio de pago"/>
                    <TextBlock x:Name="CashText" Margin="0,2,0,0" Style="{DynamicResource PageSubtitle}"
                               AutomationProperties.Name="Recibido y cambio"/>
                </StackPanel>
            </Border>

            <DockPanel Margin="0,18,0,0">
                <Button DockPanel.Dock="Right" Content="Nueva venta" Click="OnNewSale"
                        IsDefault="True" IsCancel="True" Style="{DynamicResource BigPrimaryButton}"
                        MinHeight="44" AutomationProperties.Name="Nueva venta"/>
                <Button Content="Imprimir ticket" Click="OnPrint" HorizontalAlignment="Left"
                        Style="{DynamicResource SecondaryButton}" MinHeight="44"
                        AutomationProperties.Name="Imprimir ticket"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
