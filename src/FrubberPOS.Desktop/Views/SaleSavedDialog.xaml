<Window x:Class="FrubberPOS.Desktop.Views.SaleSavedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS — Venta guardada" MinHeight="320" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        SizeToContent="Height">
    <StackPanel Margin="24">
        <TextBlock Text="Venta guardada" FontSize="20" FontWeight="Bold" Foreground="#15803D"/>
        <TextBlock x:Name="SaleNumberText" FontSize="26" FontWeight="Bold" Margin="0,12,0,4"
                   AutomationProperties.Name="Número de venta"/>
        <TextBlock x:Name="TotalText" FontSize="18" FontWeight="Bold" AutomationProperties.Name="Total"/>
        <TextBlock x:Name="PaymentText" Margin="0,4,0,0" AutomationProperties.Name="Medio de pago"/>
        <TextBlock x:Name="CashText" Margin="0,4,0,0" AutomationProperties.Name="Recibido y cambio"/>
        <TextBlock Text="La impresión del ticket es opcional." Foreground="#6B7280" Margin="0,12,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Imprimir ticket" Click="OnPrint" Padding="12,6" Margin="0,0,8,0"
                    AutomationProperties.Name="Imprimir ticket"/>
            <Button Content="Nueva venta" Click="OnNewSale" Padding="12,6"
                    FontWeight="Bold" IsDefault="True" IsCancel="True"
                    AutomationProperties.Name="Nueva venta"/>
        </StackPanel>
    </StackPanel>
</Window>
