<Window x:Class="FrubberPOS.Desktop.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="560" SizeToContent="Height" MaxHeight="640"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded"
        MouseLeftButtonDown="OnDragMove">
    <Border Style="{DynamicResource DialogCard}" Margin="16">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Click="OnCloseWindow"
                        Style="{DynamicResource SecondaryButton}" MinHeight="32" MinWidth="32" Padding="4"
                        AutomationProperties.Name="Cerrar licencia"/>
                <TextBlock Text="Licencia del equipo" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>

            <Border Style="{DynamicResource PillMint}" HorizontalAlignment="Left" Margin="0,10,0,0">
                <TextBlock Text="{Binding StatusLine}" Style="{DynamicResource PillText}" FontSize="13"
                           AutomationProperties.Name="Estado de la licencia"/>
            </Border>

            <TextBlock Text="Código de este equipo (compártalo para recibir su licencia):"
                       Style="{DynamicResource FieldLabel}" TextWrapping="Wrap" Margin="0,16,0,4"/>
            <DockPanel>
                <Button Content="Copiar" Click="OnCopyCode" DockPanel.Dock="Right" Margin="10,0,0,0"
                        Style="{DynamicResource SecondaryButton}" AutomationProperties.Name="Copiar código"/>
                <TextBox Text="{Binding MachineDisplayCode, Mode=OneWay}" IsReadOnly="True" FontSize="15"
                         VerticalContentAlignment="Center" AutomationProperties.Name="Código del equipo"/>
            </DockPanel>

            <TextBlock Text="Código de licencia recibido:" Style="{DynamicResource FieldLabel}" Margin="0,14,0,4"/>
            <TextBox Text="{Binding LicenseText, UpdateSourceTrigger=PropertyChanged}" Height="110"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                     MinHeight="40" AutomationProperties.Name="Código de licencia"/>

            <TextBlock Text="{Binding ConfirmationMessage}" Foreground="{DynamicResource SuccessBrush}"
                       FontWeight="Bold" Margin="0,10,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ErrorMessage}" Style="{DynamicResource ErrorText}" Margin="0,8,0,0"/>

            <Button Content="Activar licencia" Command="{Binding ActivateCommand}" Margin="0,14,0,0"
                    HorizontalAlignment="Left" MinHeight="44" MinWidth="150"
                    AutomationProperties.Name="Activar licencia"/>
        </StackPanel>
    </Border>
</Window>
