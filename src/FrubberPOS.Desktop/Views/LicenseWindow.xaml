<Window x:Class="FrubberPOS.Desktop.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FrubberPOS.Desktop.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="480" Height="640"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded" Closed="OnClosed"
        KeyDown="OnKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <views:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>

        <!-- Tecla del pie (kbd del prototipo) -->
        <Style x:Key="KbdPill" TargetType="Border">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="5,2"/>
        </Style>

        <!-- Boton fantasma del pie (lic-btn ghost) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F1F5F9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#475569"/>
        </Style>

        <!-- Boton peligro del mini modal (lic-btn danger) -->
        <Style x:Key="DangerButton" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#B91C1C"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FEF2F2" BorderBrush="#FECACA"
                                BorderThickness="1" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FEE2E2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Boton primario con spinner (lic-btn primary + lic-spin) -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#14B8A6" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0D9488"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#E2E8F0"/>
                                <Setter Property="Foreground" Value="#94A3B8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Spinner del boton activar -->
        <Style x:Key="LicSpinner" TargetType="Ellipse">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Height" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Stroke" Value="White"/>
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="StrokeDashArray" Value="2 2"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <RotateTransform Angle="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                 From="0" To="360" Duration="0:0:0.7" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Boton copiar (btn-copy) con estado "Copiado" -->
        <Style x:Key="CopyButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#FFFFFF" BorderBrush="#E2E8F0"
                                BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#14B8A6"/>
                                <Setter Property="Foreground" Value="#0F766E"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding CopyLabel}" Value="Copiado">
                    <Setter Property="Foreground" Value="#065F46"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="#D1FAE5" BorderBrush="#10B981" BorderThickness="1"
                                        CornerRadius="8" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Input de licencia con estado de error (code-input error) -->
        <Style x:Key="LicenseInputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#14B8A6"/>
                </Trigger>
                <DataTrigger Binding="{Binding InputError}" Value="True">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="BorderBrush" Value="#FECACA"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Modal compacto del prototipo (.license-modal, 480px, r16) sobre fondo atenuado -->
    <Grid>
        <!-- licBackdrop: clic fuera = pedir cierre -->
        <Border Background="#660F172A" MouseLeftButtonDown="OnBackdropClick"/>

        <Border Style="{DynamicResource DialogCard}" CornerRadius="16" Padding="0"
                Width="480" MaxHeight="700"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Encabezado: ícono llave + título + cerrar -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,0,0,1"
                        Padding="24,20">
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource MintBrush}">
                                <Image Source="{DynamicResource IconKey}" Width="17" Height="17"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Licencia del equipo" FontSize="18" FontWeight="Bold"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <Button Content="✕" Click="OnCloseWindow" HorizontalAlignment="Right"
                                Style="{DynamicResource SecondaryButton}" MinHeight="32" MinWidth="32" Padding="4"
                                FontSize="12" AutomationProperties.Name="Cerrar licencia"/>
                    </Grid>
                </Border>

                <!-- Cuerpo -->
                <StackPanel Grid.Row="1" Margin="24,20,24,0"
                            Visibility="{Binding ShowSuccess, Converter={StaticResource InverseBoolToVis}}">

                    <!-- Estado de la licencia (verde) -->
                    <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="#BBF7D0"
                            BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource SurfaceBrush}">
                                <Image Source="{DynamicResource IconCheckGreen}" Width="18" Height="18"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding StatusText}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#14532D" AutomationProperties.Name="Estado de la licencia"/>
                                <TextBlock Text="Frubber POS · validación fuera de línea en este equipo" FontSize="12"
                                           Foreground="#166534"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Código de este equipo -->
                    <TextBlock Text="CÓDIGO DE ESTE EQUIPO" FontSize="11" FontWeight="SemiBold" Margin="0,18,0,6"
                               Foreground="{DynamicResource TextSubBrush}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource CopyButton}"
                                Click="OnCopyCode" AutomationProperties.Name="Copiar código">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⧉" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CopyLabel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBox Text="{Binding MachineDisplayCode, Mode=OneWay}" IsReadOnly="True"
                                 Height="44" Padding="14,0" FontSize="13" FontFamily="Consolas"
                                 VerticalContentAlignment="Center" Background="#F8FAFC"
                                 AutomationProperties.Name="Código del equipo"/>
                    </DockPanel>
                    <TextBlock Text="Compártelo con soporte para recibir tu licencia por correo."
                               FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,6,0,0"/>

                    <!-- Código de licencia recibido: una línea, botón activo con forma válida -->
                    <TextBlock Text="CÓDIGO DE LICENCIA RECIBIDO" FontSize="11" FontWeight="SemiBold"
                               Margin="0,16,0,6"
                               Foreground="{DynamicResource TextSubBrush}"/>
                    <Grid>
                        <TextBox x:Name="LicenseInput" Style="{StaticResource LicenseInputStyle}"
                                 Text="{Binding LicenseText, UpdateSourceTrigger=PropertyChanged}"
                                 AutomationProperties.Name="Código de licencia"/>
                        <TextBlock Text="Pega aquí el código…" FontSize="13" FontFamily="Consolas"
                                   Foreground="#94A3B8" Margin="14,0,0,0" IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding HasText, Converter={StaticResource InverseBoolToVis}}"/>
                    </Grid>

                    <!-- Ayuda (se oculta en error: ahí manda ErrorMessage) -->
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                Visibility="{Binding ShowHelp, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ⓘ" FontSize="12" Margin="0,0,5,0"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                        <TextBlock Text="Pega la clave completa que te envió soporte." FontSize="12"
                                   Foreground="{DynamicResource MutedTextBrush}"/>
                    </StackPanel>

                    <!-- Mensajes en línea -->
                    <TextBlock Text="{Binding ConfirmationMessage}" Foreground="{DynamicResource SuccessBrush}"
                               FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorBrush}"
                               FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap"
                               AutomationProperties.Name="Error de licencia"/>
                </StackPanel>

                <!-- Panel de éxito (lic-success: reemplaza cuerpo y pie) -->
                <StackPanel Grid.Row="1" Margin="24,34,24,38" HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="{Binding ShowSuccess, Converter={StaticResource BoolToVis}}">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#D1FAE5"
                            HorizontalAlignment="Center">
                        <Image Source="{DynamicResource IconCheckGreen}" Width="24" Height="24"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="Licencia activada exitosamente" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,14,0,0"/>
                    <TextBlock Text="El sistema se reiniciará en unos segundos…" FontSize="12.5"
                               Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Pie: atajos + acciones (oculto en éxito) -->
                <Border Grid.Row="2" BorderBrush="{DynamicResource BorderSoftBrush}" BorderThickness="0,1,0,0"
                        Padding="24,14" Margin="0,20,0,0"
                        Visibility="{Binding ShowSuccess, Converter={StaticResource InverseBoolToVis}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10"
                                    VerticalAlignment="Center">
                            <Border Style="{StaticResource KbdPill}"><TextBlock Text="Esc" FontSize="10.5"
                                    FontWeight="SemiBold" Foreground="#64748B"/></Border>
                            <TextBlock Text="Cerrar" FontSize="11" Foreground="#94A3B8" Margin="5,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="·" FontSize="11" Foreground="#94A3B8" Margin="6,0"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KbdPill}"><TextBlock Text="Enter" FontSize="10.5"
                                    FontWeight="SemiBold" Foreground="#64748B"/></Border>
                            <TextBlock Text="Activar" FontSize="11" Foreground="#94A3B8" Margin="5,0,0,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="·" FontSize="11" Foreground="#94A3B8" Margin="6,0"
                                       VerticalAlignment="Center"/>
                            <Border Style="{StaticResource KbdPill}"><TextBlock Text="Ctrl+C" FontSize="10.5"
                                    FontWeight="SemiBold" Foreground="#64748B"/></Border>
                            <TextBlock Text="Copiar" FontSize="11" Foreground="#94A3B8" Margin="5,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Cancelar" Click="OnCloseWindow"
                                    Style="{StaticResource GhostButton}"
                                    Margin="0,0,8,0" AutomationProperties.Name="Cancelar licencia"/>
                            <Button Command="{Binding ActivateCommand}" IsEnabled="{Binding CanActivate}"
                                    Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="Activar licencia">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource LicSpinner}"/>
                                    <TextBlock Text="{Binding ActivateButtonContent}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Mini modal · descartar cambios (mDiscard) -->
        <Grid Visibility="{Binding ShowDiscardConfirm, Converter={StaticResource BoolToVis}}">
            <Border Background="#990F172A" MouseLeftButtonDown="OnDiscardBackdropClick"/>
            <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="16" Width="380"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Padding="24,26,24,16">
                <StackPanel>
                    <Border Width="44" Height="44" CornerRadius="22" Background="#FFFBEB"
                            HorizontalAlignment="Center">
                        <TextBlock Text="⚠" FontSize="19" Foreground="#D97706" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="¿Descartar cambios?" FontSize="15" FontWeight="Bold"
                               HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    <TextBlock Text="Tienes un código de licencia sin activar." FontSize="12.5"
                               Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Center"
                               Margin="0,5,0,0" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                        <Button Content="Seguir editando" Click="OnKeepEditing"
                                Style="{StaticResource GhostButton}" Margin="0,0,8,0"/>
                        <Button Content="Descartar" Click="OnDiscard"
                                Style="{StaticResource DangerButton}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
