<Window x:Class="FrubberPOS.Desktop.Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS — Licencia" Height="540" Width="560" MinWidth="480" MinHeight="460"
        WindowStartupLocation="CenterOwner" Loaded="OnLoaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <TextBlock Text="Licencia del equipo" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="{Binding StatusLine}" Margin="0,12,0,4" FontWeight="Bold" FontSize="16"/>

            <TextBlock Text="Código de este equipo (compártalo para recibir su licencia):" TextWrapping="Wrap" Margin="0,8,0,4"/>
            <DockPanel>
                <Button Content="Copiar" Click="OnCopyCode" Padding="12,4" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                <TextBox Text="{Binding MachineDisplayCode, Mode=OneWay}" IsReadOnly="True" FontSize="16" Padding="6" VerticalContentAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="Código de licencia recibido:" Margin="0,16,0,4"/>
            <TextBox Text="{Binding LicenseText, UpdateSourceTrigger=PropertyChanged}" Height="120" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" AcceptsReturn="True" Padding="6"/>
            <Button Content="Activar" Command="{Binding ActivateCommand}" Padding="12,6" Margin="0,12,0,0" HorizontalAlignment="Left"/>
            <TextBlock Text="{Binding ConfirmationMessage}" Foreground="#15803D" Margin="0,8,0,0" TextWrapping="Wrap" FontWeight="Bold"/>
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
    </ScrollViewer>
</Window>
