<Window x:Class="FrubberPOS.Desktop.Views.TrialBlockedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS" SizeToContent="Height" MinHeight="320" Width="520" MinWidth="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Background="{DynamicResource AppBackground}">
        <Ellipse Fill="{DynamicResource MintBrush}" Opacity="0.9" Width="300" Height="300"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-120,0,0,-120"/>
        <Border Style="{DynamicResource DialogCard}" Margin="40" VerticalAlignment="Center">
            <StackPanel>
                <TextBlock Text="Frubber POS no puede iniciar" FontSize="20" FontWeight="Bold"/>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="70"/>
                <DockPanel Margin="0,18,0,0">
                    <Button DockPanel.Dock="Right" Content="Salir" Command="{Binding ExitCommand}"
                            Style="{DynamicResource SecondaryButton}" MinWidth="100"
                            AutomationProperties.Name="Salir"/>
                    <Button Content="Activar licencia" Command="{Binding ActivateCommand}" MinHeight="44"
                            HorizontalAlignment="Left" AutomationProperties.Name="Activar licencia"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
