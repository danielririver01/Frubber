<Window x:Class="FrubberPOS.Desktop.Views.TrialBlockedWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS" Height="300" Width="520" MinWidth="440" MinHeight="260"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Frubber POS no puede iniciar" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,12,0,0" MinHeight="80"/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Activar licencia" Command="{Binding ActivateCommand}" Padding="12,6"/>
            <Button Content="Salir" Command="{Binding ExitCommand}" Padding="12,6" Margin="12,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
