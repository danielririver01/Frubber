<Window x:Class="FrubberPOS.Desktop.Views.ProductEditorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FrubberPOS.Desktop.Views"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        MouseLeftButtonDown="OnDragMove">
    <Window.Resources>
        <v:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis"/>
    </Window.Resources>
    <Border Style="{DynamicResource DialogCard}" Margin="16" Padding="28,24">
        <StackPanel>
            <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="Bold"/>

            <TextBlock Text="PLU (letras y números, en mayúsculas):" Style="{DynamicResource FieldLabel}" Margin="0,14,0,4"/>
            <TextBox x:Name="PluBox" Text="{Binding Plu, UpdateSourceTrigger=PropertyChanged}"
                     LostFocus="OnPluLostFocus" CharacterCasing="Upper" AutomationProperties.Name="PLU"/>

            <TextBlock Text="Nombre:" Style="{DynamicResource FieldLabel}" Margin="0,10,0,4"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Nombre del producto"/>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Unidad:" Style="{DynamicResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Units}"
                              SelectedItem="{Binding SelectedUnit}"
                              DisplayMemberPath="Code"
                              IsEnabled="{Binding IsUnitEnabled}"
                              AutomationProperties.Name="Unidad de venta"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Precio (pesos):" Style="{DynamicResource FieldLabel}"/>
                    <TextBox Text="{Binding PriceText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Precio en pesos"/>
                </StackPanel>
            </Grid>
            <TextBlock Text="{Binding UnitLockedHint}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="{Binding IsUnitEnabled, Converter={StaticResource InverseBoolToVis}}"/>

            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource InverseBoolToVis}}">
                <TextBlock Text="Existencia inicial (kg/lb con 3 decimales; unidad entera):"
                           Style="{DynamicResource FieldLabel}" Margin="0,10,0,4"/>
                <DockPanel>
                    <!-- JHO-92: la báscula (canasta/balde sobre el plato) rellena la
                         existencia; el envase se descarga con la tecla TARA de la báscula. -->
                    <Button DockPanel.Dock="Right" Content="Leer báscula" Command="{Binding ReadScaleCommand}"
                            Style="{DynamicResource SecondaryButton}" MinHeight="30" Padding="10,2" Margin="8,0,0,0"
                            AutomationProperties.Name="Leer báscula producto"/>
                    <TextBox Text="{Binding StockText, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Existencia inicial"/>
                </DockPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12" Margin="0,4,0,0" AutomationProperties.Name="Estado báscula producto"/>
            </StackPanel>

            <CheckBox Content="Producto activo" IsChecked="{Binding IsActive}" Margin="0,14,0,0" FontSize="14"/>

            <TextBlock Text="{Binding ErrorMessage}" Style="{DynamicResource ErrorText}" Margin="0,10,0,0"/>

            <DockPanel Margin="0,16,0,0">
                <Button DockPanel.Dock="Right" Content="Guardar" Command="{Binding SaveCommand}"
                        MinWidth="110" AutomationProperties.Name="Guardar producto"/>
                <Button Content="Cancelar" Click="OnCancel" HorizontalAlignment="Left"
                        Style="{DynamicResource SecondaryButton}"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
