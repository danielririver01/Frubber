<Window x:Class="FrubberPOS.Desktop.Views.FirstStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS — Primer inicio" Height="520" Width="460"
        WindowStartupLocation="CenterScreen">
    <Grid Background="{DynamicResource AppBackground}">
        <Ellipse Fill="{DynamicResource MintBrush}" Opacity="0.9" Width="340" Height="340"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-140,0,0,-140"/>
        <Ellipse Fill="{DynamicResource MintBrush}" Opacity="0.9" Width="380" Height="380"
                 HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-160,-160,0"/>

        <Border Style="{DynamicResource DialogCard}" Margin="40" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Width="34" Height="34" CornerRadius="999" Background="{DynamicResource PrimaryBrush}">
                        <TextBlock Text="F" Foreground="White" FontWeight="Bold" FontSize="16"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Frubber POS" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Bienvenido a Frubber POS" Style="{DynamicResource PageTitle}" FontSize="20" TextWrapping="Wrap"/>
                <TextBlock Text="Cree el administrador inicial para empezar:" Style="{DynamicResource PageSubtitle}"
                           Margin="0,4,0,0" TextWrapping="Wrap"/>

                <TextBlock Text="Nombre:" Style="{DynamicResource FieldLabel}" Margin="0,14,0,4"/>
                <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"
                         AutomationProperties.Name="Nombre del administrador"/>
                <TextBlock Text="PIN (4 dígitos):" Style="{DynamicResource FieldLabel}" Margin="0,10,0,4"/>
                <PasswordBox x:Name="PinBox" MaxLength="4" PasswordChanged="PinBox_PasswordChanged"
                             AutomationProperties.Name="PIN del administrador"/>
                <TextBlock Text="Confirmar PIN:" Style="{DynamicResource FieldLabel}" Margin="0,10,0,4"/>
                <PasswordBox x:Name="ConfirmBox" MaxLength="4" PasswordChanged="ConfirmBox_PasswordChanged"
                             AutomationProperties.Name="Confirmar PIN"/>

                <TextBlock Text="{Binding ErrorMessage}" Style="{DynamicResource ErrorText}" Margin="0,10,0,0"/>
                <Button Content="Crear administrador" Command="{Binding CreateCommand}" Margin="0,14,0,0"
                        MinHeight="44" AutomationProperties.Name="Crear administrador"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
