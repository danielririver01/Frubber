<Window x:Class="FrubberPOS.Desktop.Views.FirstStartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS — Primer inicio" Height="380" Width="380"
        WindowStartupLocation="CenterScreen">
    <StackPanel Margin="24">
        <TextBlock Text="Bienvenido a Frubber POS" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"/>
        <TextBlock Text="Cree el administrador inicial:" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="Nombre:" Margin="0,12,0,4"/>
        <TextBox Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" MaxLength="60"/>
        <TextBlock Text="PIN (4 dígitos):" Margin="0,12,0,4"/>
        <PasswordBox x:Name="PinBox" MaxLength="4" PasswordChanged="PinBox_PasswordChanged"/>
        <TextBlock Text="Confirmar PIN:" Margin="0,12,0,4"/>
        <PasswordBox x:Name="ConfirmBox" MaxLength="4" PasswordChanged="ConfirmBox_PasswordChanged"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" Margin="0,8,0,0" TextWrapping="Wrap"/>
        <Button Content="Crear administrador" Command="{Binding CreateCommand}" Margin="0,12,0,0" Padding="0,8"/>
    </StackPanel>
</Window>
