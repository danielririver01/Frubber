<UserControl x:Class="FrubberPOS.Desktop.Views.TpvView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <!-- Buscador arriba (P-UX-002): F2 enfoca -->
        <Border DockPanel.Dock="Top" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6"
                Padding="8" Margin="0,0,0,8">
            <DockPanel>
                <Border DockPanel.Dock="Right" VerticalAlignment="Center" CornerRadius="3"
                        BorderBrush="#D1D5DB" BorderThickness="1" Margin="8,0,0,0">
                    <TextBlock Text="F2" Foreground="#6B7280" Padding="5,1"/>
                </Border>
                <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="14" Padding="6,3" AutomationProperties.Name="Buscar producto"
                         ToolTip="Buscar por PLU o nombre (F2)" />
            </DockPanel>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Resultados -->
            <DataGrid Grid.Row="0" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}"
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                      RowHeight="28" Margin="0,0,0,8"
                      AutomationProperties.Name="Resultados de búsqueda">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="PLU" Binding="{Binding Plu}" Width="90"/>
                    <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Unidad" Binding="{Binding UnitCode}" Width="90"/>
                    <DataGridTextColumn Header="Precio" Binding="{Binding PriceText}" Width="110"/>
                    <DataGridTextColumn Header="Existencia" Binding="{Binding StockText}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Borrador -->
            <DockPanel Grid.Row="1">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="Venta en preparación" FontWeight="Bold"/>
                    <Button Content="Limpiar" Command="{Binding ClearDraftCommand}" Padding="10,3"
                            Margin="8,0,0,0" HorizontalAlignment="Left"/>
                    <Button Content="Agregar" Command="{Binding AddSelectedCommand}" Padding="10,3"
                            Margin="8,0,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                    <TextBlock Text="Total:" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="{Binding SubtotalText}" FontWeight="Bold" FontSize="16" Margin="8,0,0,0"
                               AutomationProperties.Name="Total de la venta"/>
                </StackPanel>
                <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False"
                          RowHeight="24" AutomationProperties.Name="Líneas de la venta">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Cant." Binding="{Binding QuantityMilli}" Width="90"/>
                        <DataGridTextColumn Header="Importe" Binding="{Binding LineTotalCop}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
