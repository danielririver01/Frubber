<Window x:Class="FrubberPOS.Desktop.Views.QuantityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS — Cantidad" Height="240" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Cantidad" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding ProductLabel}" Margin="0,12,0,4" FontWeight="Bold" FontSize="14"/>
        <TextBlock Text="{Binding UnitCode, StringFormat='Unidad: {0}'}" Margin="0,0,0,6"/>
        <TextBox x:Name="QuantityBox" Text="{Binding QuantityText, UpdateSourceTrigger=PropertyChanged}"
                 FontSize="16" Padding="6" AutomationProperties.Name="Cantidad"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="OnCancel" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Aceptar" Command="{Binding ConfirmCommand}" Padding="12,6"
                    FontWeight="Bold" IsDefault="True"/>
        </StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
