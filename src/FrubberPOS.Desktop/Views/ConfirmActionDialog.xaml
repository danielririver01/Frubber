<Window x:Class="FrubberPOS.Desktop.Views.ConfirmActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="220" Width="480" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        KeyDown="OnKeyDown">
    <StackPanel Margin="24">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}"/>
        <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap"
                   AutomationProperties.Name="Mensaje de confirmación"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancelar (Esc)" Click="OnCancel" Padding="12,6" Margin="0,0,8,0" IsCancel="True"
                    Style="{DynamicResource SecondaryButton}"
                    AutomationProperties.Name="Cancelar acción"/>
            <Button x:Name="ConfirmButton" Click="OnConfirm" Padding="12,6" FontWeight="Bold"
                    Style="{DynamicResource DangerButton}"/>
        </StackPanel>
    </StackPanel>
</Window>
