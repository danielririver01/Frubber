<Window x:Class="FrubberPOS.Desktop.Views.ConfirmActionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="480" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        KeyDown="OnKeyDown" MouseLeftButtonDown="OnDragMove">
    <Border Style="{DynamicResource DialogCard}" Margin="16">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}"/>
            <TextBlock x:Name="MessageText" Margin="0,12,0,0" TextWrapping="Wrap"
                       AutomationProperties.Name="Mensaje de confirmación"/>
            <DockPanel Margin="0,18,0,0">
                <Button x:Name="ConfirmButton" Click="OnConfirm" DockPanel.Dock="Right"
                        Style="{DynamicResource DangerButton}" MinWidth="140"/>
                <Button Content="Cancelar (Esc)" Click="OnCancel" IsCancel="True"
                        Style="{DynamicResource SecondaryButton}" HorizontalAlignment="Left"
                        AutomationProperties.Name="Cancelar acción"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
