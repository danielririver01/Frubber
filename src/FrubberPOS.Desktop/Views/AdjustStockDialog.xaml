<Window x:Class="FrubberPOS.Desktop.Views.AdjustStockDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Frubber POS — Ajuste de existencia" Height="300" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="24">
        <TextBlock Text="Ajuste de existencia" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding ProductLabel}" Margin="0,12,0,4" FontWeight="Bold" FontSize="14"/>

        <DockPanel Margin="0,8,0,0">
            <TextBlock Text="Existencia actual:"/>
            <TextBlock Text="{Binding CurrentStockText}" FontWeight="Bold" HorizontalAlignment="Right"/>
        </DockPanel>

        <TextBlock Text="Nueva existencia (puede ser negativa):" Margin="0,12,0,4"/>
        <TextBox Text="{Binding NewStockText, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="6"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Click="OnCancel" Padding="12,6" Margin="0,0,8,0"/>
            <Button Content="Guardar" Command="{Binding SaveCommand}" Padding="12,6" FontWeight="Bold"/>
        </StackPanel>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</Window>
