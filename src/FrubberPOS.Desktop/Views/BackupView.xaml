<UserControl x:Class="FrubberPOS.Desktop.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
        <TextBlock Text="Respaldo de la base de datos" FontSize="18" FontWeight="Bold" Margin="0,0,10,0"/>
        <TextBlock TextWrapping="Wrap" Foreground="#374151"
                   Text="Crea una copia consistente de la base de datos en la ubicación que elija. La copia se escribe con el mecanismo de respaldo de SQLite y se publica de forma atómica. Restaurar un respaldo no se hace desde la aplicación."/>
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Crear respaldo..." Command="{Binding CreateBackupCommand}" Padding="16,6"
                    FontWeight="Bold"
                    AutomationProperties.Name="Crear respaldo"/>
            <ProgressBar IsIndeterminate="True" Width="140" Height="6" Margin="14,0,0,0"
                         VerticalAlignment="Center"
                         Visibility="{Binding Busy, Converter={StaticResource BoolToVis}}"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusMessage}" Foreground="#15803D" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="{Binding ErrorMessage}" Foreground="#B91C1C" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
