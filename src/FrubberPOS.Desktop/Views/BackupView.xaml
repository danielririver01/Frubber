<UserControl x:Class="FrubberPOS.Desktop.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:FrubberPOS.Desktop.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:BackupViewModel}">
    <UserControl.Resources>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel MaxWidth="1100" Margin="24">

            <!-- KPI row (JHO-81 / bk-1) -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{DynamicResource PillMint}" Padding="14,10" Grid.Column="0" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Tamaño de tus datos" Style="{DynamicResource ColumnCaption}"/>
                        <TextBlock Text="{Binding DatabaseSizeText}" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource PillMint}" Padding="14,10" Grid.Column="1" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Último respaldo" Style="{DynamicResource ColumnCaption}"/>
                        <TextBlock Text="{Binding LastBackupText}" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource PillMint}" Padding="14,10" Grid.Column="2" Margin="0,0,6,0">
                    <StackPanel>
                        <TextBlock Text="Copia en USB" Style="{DynamicResource ColumnCaption}"/>
                        <TextBlock Text="{Binding UsbText}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding UsbNote}" Style="{DynamicResource ColumnCaption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Border Style="{DynamicResource PillMint}" Padding="14,10" Grid.Column="3">
                    <StackPanel>
                        <TextBlock Text="Alertas" Style="{DynamicResource ColumnCaption}"/>
                        <TextBlock Text="{Binding AlertCountText}" FontWeight="Bold"/>
                        <TextBlock Text="{Binding AlertNote}" Style="{DynamicResource ColumnCaption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Health banner (JHO-81 / bk-1) -->
            <Border Margin="0,0,0,16" Padding="18,14" CornerRadius="10"
                    Background="{DynamicResource WarnSoftBrush}"
                    BorderBrush="{DynamicResource WarnBorderBrush}"
                    BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Setter Property="CornerRadius" Value="10"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHealthy}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding BannerTitle}" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Text="{Binding BannerSubtitle}" Style="{DynamicResource PageSubtitle}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Crear respaldo ahora"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="16,0,0,0"
                            Command="{Binding CreateBackupCommand}"
                            AutomationProperties.Name="Crear respaldo ahora"/>
                </Grid>
            </Border>

            <!-- Two columns (JHO-81 / bk-17 left pattern, educational right) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource Card}" Padding="20" Margin="0,0,12,0" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Copia de seguridad de tus datos" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Style="{DynamicResource PageSubtitle}" TextWrapping="Wrap" Margin="0,6,0,14"
                                   Text="Elige dónde guardar el archivo. El programa nunca borra tu base de datos al hacer un respaldo."/>

                        <TextBlock Text="Se guarda en" Style="{DynamicResource ColumnCaption}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding SaveFolderRowText}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Dónde se guarda" Style="{DynamicResource ColumnCaption}"/>
                                <TextBlock Text="Eliges carpeta" FontWeight="SemiBold"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Tamaño de tus datos" Style="{DynamicResource ColumnCaption}"/>
                                <TextBlock Text="{Binding DatabaseSizeText}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Última copia" Style="{DynamicResource ColumnCaption}"/>
                                <TextBlock Text="{Binding LastRecapText}" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Grid>

                        <Button Content="Crear respaldo"
                                HorizontalAlignment="Left"
                                Command="{Binding CreateBackupCommand}"
                                AutomationProperties.Name="Crear respaldo"/>

                        <TextBlock Text="{Binding StatusMessage}"
                                   Style="{DynamicResource PageSubtitle}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                        <TextBlock Text="{Binding ErrorMessage}"
                                   Style="{DynamicResource ErrorText}"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{DynamicResource Card}" Padding="20" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="Qué guarda el respaldo" Style="{StaticResource SectionHeading}"/>
                        <TextBlock Style="{DynamicResource PageSubtitle}" TextWrapping="Wrap" Margin="0,6,0,12"
                                   Text="Un solo archivo con toda la información del negocio, listo para un soporte externo (USB, disco o nube)."/>

                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Productos, precios y stock" FontWeight="SemiBold"/>
                            <TextBlock Text="Historial de ventas y anulaciones" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="Usuarios, roles y configuración" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <TextBlock Text="Cajas y arqueos" FontWeight="SemiBold" Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Background="{DynamicResource SubtleBrush}" CornerRadius="8" Padding="12" Margin="0,4,0,0">
                            <TextBlock Style="{DynamicResource PageSubtitle}" TextWrapping="Wrap"
                                       Text="Consejo: guarda una copia en un USB o en la nube, fuera del mismo computador. No necesitas restaurar desde la aplicación para usar el archivo."/>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
