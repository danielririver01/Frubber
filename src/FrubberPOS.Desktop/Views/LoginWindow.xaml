<Window x:Class="FrubberPOS.Desktop.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FrubberPOS.Desktop.Views"
        Title="Frubber POS — Iniciar sesión" Height="660" Width="1000" MinWidth="820" MinHeight="560"
        WindowStartupLocation="CenterScreen" Loaded="OnLoaded" PreviewKeyDown="OnPreviewKeyDown"
        Background="{DynamicResource LoginBackdrop}">
    <!-- La tarjeta concentra todo el contenido (JHO-64); la ventana solo aporta fondo y teclado. -->
    <local:LoginCardView x:Name="Card"
                         IsLockMode="{Binding IsLockMode, Mode=OneWay}"
                         CloseRequested="OnCardCloseRequested"/>
</Window>
