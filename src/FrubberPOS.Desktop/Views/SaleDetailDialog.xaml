<Window x:Class="FrubberPOS.Desktop.Views.SaleDetailDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Width="560" SizeToContent="Height" MaxHeight="680"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        MouseLeftButtonDown="OnDragMove">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- JHO-75: mismo patrón JHO-74 — DataGridCell.Padding no se aplica
             en WPF; el margen banda [col+10..col-10] alinea cabecera y valor. -->
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="Margin" Value="10,0,10,0"/>
        </Style>
        <Style x:Key="CellTextRight" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="HorizontalAlignment" Value="Right"/>
        </Style>
        <Style x:Key="HeaderRight" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource ColumnHeaderBase}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
    </Window.Resources>
    <Border Style="{DynamicResource DialogCard}" Margin="16">
        <StackPanel>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="✕" Click="OnClose"
                        Style="{DynamicResource SecondaryButton}" MinHeight="32" MinWidth="32" Padding="4"
                        AutomationProperties.Name="Cerrar detalle"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SaleNumberText}" FontSize="22" FontWeight="Bold"
                               VerticalAlignment="Center" AutomationProperties.Name="Número de venta"/>
                    <Border Style="{DynamicResource PillMint}" Margin="10,0,0,0">
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                   FontWeight="Bold" FontSize="12"
                                   AutomationProperties.Name="Estado de la venta"/>
                    </Border>
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding MomentText}" Style="{DynamicResource PageSubtitle}" Margin="0,6,0,0"
                       AutomationProperties.Name="Fecha y hora"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                <TextBlock Text="{Binding CashSessionText}" Style="{DynamicResource PageSubtitle}"
                           AutomationProperties.Name="Caja"/>
                <TextBlock Text="  ·  " Style="{DynamicResource PageSubtitle}"/>
                <TextBlock Text="{Binding CashierText}" Style="{DynamicResource PageSubtitle}"
                           AutomationProperties.Name="Cajero"/>
                <TextBlock Text="  ·  " Style="{DynamicResource PageSubtitle}"/>
                <TextBlock Text="{Binding PaymentText}" Style="{DynamicResource PageSubtitle}"
                           AutomationProperties.Name="Medio de pago"/>
            </StackPanel>
            <TextBlock Text="{Binding CashDetailText}" Style="{DynamicResource PageSubtitle}" Margin="0,2,0,0"
                       AutomationProperties.Name="Recibido y cambio"/>

            <Border Background="{DynamicResource ErrorSoftBrush}" CornerRadius="8" Padding="12,8" Margin="0,8,0,0"
                    Visibility="{Binding VoidInfoVisible, Converter={StaticResource BoolToVis}}"
                    AutomationProperties.Name="Datos de la anulación">
                <TextBlock Text="{Binding VoidInfoText}" Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold"/>
            </Border>

            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                    Margin="0,12,0,0" MaxHeight="240">
                <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          AutomationProperties.Name="Líneas históricas">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding LineNumber}" Width="44"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="PLU" Binding="{Binding Plu}" Width="70"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Producto" Binding="{Binding Name}" Width="*"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Header="Cantidad" Binding="{Binding QuantityText}" Width="100"
                                            ElementStyle="{StaticResource CellText}"/>
                        <DataGridTextColumn Binding="{Binding PriceText}" Width="90"
                                            HeaderStyle="{StaticResource HeaderRight}"
                                            ElementStyle="{StaticResource CellTextRight}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Precio" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                        <DataGridTextColumn Binding="{Binding TotalText}" Width="90"
                                            HeaderStyle="{StaticResource HeaderRight}"
                                            ElementStyle="{StaticResource CellTextRight}">
                            <DataGridTextColumn.Header>
                                <TextBlock Text="Importe" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </DataGridTextColumn.Header>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <DockPanel Margin="0,10,0,0">
                <TextBlock Text="Subtotal" Style="{DynamicResource PageSubtitle}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SubtotalText}" FontWeight="SemiBold" Margin="8,0,18,0" VerticalAlignment="Center"
                           AutomationProperties.Name="Subtotal"/>
                <TextBlock Text="Descuento" Style="{DynamicResource PageSubtitle}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding DiscountText}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                           AutomationProperties.Name="Descuento"/>
            </DockPanel>
            <DockPanel Margin="0,6,0,0">
                <Border DockPanel.Dock="Right" Background="{DynamicResource MintBrush}" CornerRadius="8" Padding="12,6">
                    <TextBlock Text="{Binding TotalText}" FontSize="20" FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryBrush}" AutomationProperties.Name="Total"/>
                </Border>
                <TextBlock Text="TOTAL" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
            </DockPanel>

            <TextBlock Text="{Binding ErrorMessage}" Style="{DynamicResource ErrorText}" Margin="0,8,0,0"/>

            <DockPanel Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="Cerrar" Click="OnClose" IsCancel="True"
                        Style="{DynamicResource SecondaryButton}" MinWidth="100"
                        AutomationProperties.Name="Cerrar detalle"/>
                <Button Content="Anular venta" Command="{Binding VoidCommand}"
                        Style="{DynamicResource DangerButton}" HorizontalAlignment="Left"
                        Visibility="{Binding VoidButtonVisible, Converter={StaticResource BoolToVis}}"
                        AutomationProperties.Name="Anular venta"/>
            </DockPanel>
        </StackPanel>
    </Border>
</Window>
