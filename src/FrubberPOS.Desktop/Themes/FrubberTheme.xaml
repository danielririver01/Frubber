<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Frubber POS — sistema visual v3 (JHO-52/59 → rediseño JHO-69),
        fuente normativa: prototipos HTML del dueño
        `Documentacion/Diseño de Interfaz y Experiencia de Usuario/frubber-pos*.html`
        (2026-10-02). Tokens :root exactos; paleta teal Slate/Tailwind;
        radios 6/10/12/14; espaciado en pasos de 4 (4–32); Inter empaquetada
        (Resources/Fonts) con fallback Segoe UI; contraste AA conservado:
        acción principal sólida #0F766E (teal-500 solo en marca/fondos suaves).
    -->

    <!-- ===== Tokens de color (prototipo :root) ===== -->
    <Color x:Key="AppBackgroundColor">#F7F8FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="PrimaryColor">#0F766E</Color>
    <Color x:Key="PrimaryActiveColor">#115E59</Color>
    <Color x:Key="AccentColor">#14B8A6</Color>
    <Color x:Key="AccentSoftColor">#0D9488</Color>
    <Color x:Key="TextColor">#0F172A</Color>
    <Color x:Key="SecondaryTextColor">#475569</Color>
    <Color x:Key="MutedTextColor">#94A3B8</Color>
    <Color x:Key="TextSubColor">#64748B</Color>
    <Color x:Key="BorderColor">#E2E8F0</Color>
    <Color x:Key="BorderSoftColor">#EEF1F4</Color>
    <Color x:Key="BorderHoverColor">#CBD5E1</Color>
    <Color x:Key="SuccessColor">#047857</Color>
    <Color x:Key="WarningColor">#B45309</Color>
    <Color x:Key="ErrorColor">#DC2626</Color>
    <Color x:Key="FocusColor">#0F9488</Color>
    <Color x:Key="SubtleColor">#F1F5F9</Color>

    <!-- Derivados: teal suave (selección/píldoras), fila menta y estados -->
    <Color x:Key="MintColor">#E6FAF5</Color>
    <Color x:Key="MintHoverColor">#F8FAFC</Color>
    <Color x:Key="MintRowColor">#F0FDF9</Color>
    <Color x:Key="MintBorderColor">#99F6E4</Color>
    <Color x:Key="GreenDotColor">#10B981</Color>
    <Color x:Key="WarnSoftColor">#FFFBEB</Color>
    <Color x:Key="ErrorSoftColor">#FEF2F2</Color>
    <Color x:Key="ErrorBorderColor">#FECACA</Color>
    <Color x:Key="ErrorHoverColor">#FEE2E2</Color>
    <Color x:Key="SuccessSoftColor">#ECFDF5</Color>
    <Color x:Key="TrialColor">#FEF3C7</Color>
    <Color x:Key="TrialTextColor">#92400E</Color>
    <Color x:Key="OfflineTextColor">#D97706</Color>

    <!--
        JHO-67 · rediseño R2 (Venta/TPV + cobro): tokens derivados de los
        prototipos del dueño. WarnBorder = borde del banner ámbar
        (.health-banner warning / #FDE68A); Disabled* = .btn-cobrar:disabled
        (#CBD5E1 con texto blanco); Toast = pastilla flotante (.toast);
        PillNeutral = .pill.off (slate-100 + text-sub); OnBrand = texto sobre
        acción primaria sólida.
    -->
    <Color x:Key="WarnBorderColor">#FDE68A</Color>
    <Color x:Key="DisabledSurfaceColor">#CBD5E1</Color>
    <Color x:Key="DisabledTextColor">#FFFFFF</Color>
    <Color x:Key="ToastSurfaceColor">#0F172A</Color>
    <Color x:Key="ToastTextColor">#FFFFFF</Color>
    <Color x:Key="PillNeutralColor">#F1F5F9</Color>
    <Color x:Key="PillNeutralTextColor">#64748B</Color>
    <Color x:Key="OnBrandColor">#FFFFFF</Color>

    <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="{StaticResource PrimaryActiveColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="TextSubBrush" Color="{StaticResource TextSubColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="GreenDotBrush" Color="{StaticResource GreenDotColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="OfflineTextBrush" Color="{StaticResource OfflineTextColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="{StaticResource ErrorBorderColor}"/>
    <SolidColorBrush x:Key="ErrorHoverBrush" Color="{StaticResource ErrorHoverColor}"/>
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}"/>
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}"/>
    <SolidColorBrush x:Key="MintHoverBrush" Color="{StaticResource MintHoverColor}"/>
    <SolidColorBrush x:Key="MintRowBrush" Color="{StaticResource MintRowColor}"/>
    <SolidColorBrush x:Key="MintBorderBrush" Color="{StaticResource MintBorderColor}"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}"/>
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource ErrorSoftColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="TrialBrush" Color="{StaticResource TrialColor}"/>
    <SolidColorBrush x:Key="TrialTextBrush" Color="{StaticResource TrialTextColor}"/>
    <SolidColorBrush x:Key="WarnBorderBrush" Color="{StaticResource WarnBorderColor}"/>
    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="{StaticResource DisabledSurfaceColor}"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}"/>
    <SolidColorBrush x:Key="ToastSurfaceBrush" Color="{StaticResource ToastSurfaceColor}"/>
    <SolidColorBrush x:Key="ToastTextBrush" Color="{StaticResource ToastTextColor}"/>
    <SolidColorBrush x:Key="PillNeutralBrush" Color="{StaticResource PillNeutralColor}"/>
    <SolidColorBrush x:Key="PillNeutralTextBrush" Color="{StaticResource PillNeutralTextColor}"/>
    <SolidColorBrush x:Key="OnBrandBrush" Color="{StaticResource OnBrandColor}"/>

    <!-- ===== Marca: degradados del logo "F" (sidebar/splash) ===== -->
    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#14B8A6" Offset="0"/>
        <GradientStop Color="#0F766E" Offset="1"/>
    </LinearGradientBrush>
    <!-- Fondo de login/bloqueo (body de frubber-pos-login.html, gradiente 165deg) -->
    <LinearGradientBrush x:Key="LoginBackdrop" StartPoint="0.39,0" EndPoint="0.61,1">
        <GradientStop Color="{StaticResource AppBackgroundColor}" Offset="0"/>
        <GradientStop Color="#E8EAEC" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AvatarGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#14B8A6" Offset="0"/>
        <GradientStop Color="#0F766E" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SplashLogoGradient" StartPoint="0,0" EndPoint="0.75,1">
        <GradientStop Color="#35B2A6" Offset="0"/>
        <GradientStop Color="#246E68" Offset="1"/>
    </LinearGradientBrush>

    <!-- ===== Iconos de trazo fino (SVG 24×24 stroke 1.9 → geometría) ===== -->
    <DrawingImage x:Key="IconCheck">
        <DrawingImage.Drawing>
            <GeometryDrawing Geometry="M 5 12.5 L 10 17.5 L 19 7">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FFFFFFFF" Thickness="2.4" StartLineCap="Round" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Check verde para cajas claras (estado de licencia / panel de éxito) -->
    <DrawingImage x:Key="IconCheckGreen">
        <DrawingImage.Drawing>
            <GeometryDrawing Geometry="M 5 12.5 L 10 17.5 L 19 7">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FF16A34A" Thickness="2.4" StartLineCap="Round" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Llave fina (Feather key) para el encabezado del modal de licencia -->
    <DrawingImage x:Key="IconKey">
        <DrawingImage.Drawing>
            <GeometryDrawing Geometry="M 21 2 L 19 4 M 11.39 11.61 A 5.5 5.5 0 1 1 3.612 19.388 A 5.5 5.5 0 0 1 11.389 11.611 M 11.389 11.611 L 15.5 7.5 L 18.5 10.5 L 22 7 L 19 4 M 15.5 7.5 L 19 4">
                <GeometryDrawing.Pen>
                    <Pen Brush="#FF0F766E" Thickness="2" StartLineCap="Round" EndLineCap="Round"/>
                </GeometryDrawing.Pen>
            </GeometryDrawing>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- ===== Foco visible: anillo punteado teal (≥2 DIPs, AA) ===== -->
    <Style x:Key="FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3" Stroke="{StaticResource FocusBrush}"
                               StrokeThickness="2" StrokeDashArray="4 2" RadiusX="4" RadiusY="4"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Contenedores: cards radio 12 (r-l), borde suave sin sombra ===== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="12"/>
        <Setter Property="Padding" Value="16"/>
    </Style>

    <Style x:Key="PillMint" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MintBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MintBorderBrush}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <Style x:Key="PillWarn" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource WarnSoftBrush}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <Style x:Key="PillTrial" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource TrialBrush}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Padding" Value="10,3"/>
    </Style>

    <Style x:Key="AvatarCircle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource MintBrush}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
    </Style>

    <!-- KPI card: contenido con barra superior de color -->
    <Style x:Key="KpiCard" TargetType="Border" BasedOn="{StaticResource Card}">
        <Setter Property="Padding" Value="0"/>
    </Style>

    <!-- Logo de marca 40×40 con degradado y letra F (sidebar/login) -->
    <Style x:Key="BrandLogo" TargetType="Border">
        <Setter Property="Width" Value="40"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Background" Value="{StaticResource BrandGradient}"/>
    </Style>

    <!-- ===== Tipografía: Inter empaquetada → Segoe UI ===== -->
    <FontFamily x:Key="AppFont">pack://application:,,,/Resources/Fonts/#Inter, Segoe UI</FontFamily>

    <Style TargetType="Window">
        <Setter Property="Background" Value="{StaticResource AppBackground}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style TargetType="UserControl">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Título de página del encabezado (“Venta” 28, ink) -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <!-- Encabezado de columna: 11px, seminegrita, mayúsculas gris sub -->
    <Style x:Key="ColumnCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
    </Style>

    <Style x:Key="NumericText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="DisplayTotal" TargetType="TextBlock">
        <Setter Property="FontSize" Value="32"/>
        <Setter Property="FontWeight" Value="ExtraBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style x:Key="KpiMetric" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <Style x:Key="PillText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
    </Style>

    <Style x:Key="ErrorText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- Chip de atajo físico (F2, F4, F8, SUPR) -->
    <Style x:Key="ShortcutChip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SubtleBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="6,1"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="ShortcutText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
    </Style>

    <!-- ===== Botones: radio 10 (r-m), objetivo ≥ 40 ===== -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryActiveBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Acción principal del TPV/modal: 44–48 DIPs. Plantilla propia porque el
        deshabilitado del prototipo es sólido (#CBD5E1 + texto blanco,
        .btn-cobrar:disabled) y el trigger de plantilla base (Opacidad 0.55)
        lavaría el texto; el hover deshabilitado no pinta nada.
    -->
    <Style x:Key="BigPrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Padding" Value="28,10"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource DisabledSurfaceBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource PrimaryActiveBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Cursor" Value="No"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Secundario: blanco con borde slate, hover #F8FAFC + #CBD5E1 -->
    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource SecondaryTextBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource MintHoverBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource BorderHoverBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Destructivo -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource ErrorBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#B91C1C"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Tecla del pad del login: 48 alto, blanco con borde -->
    <Style x:Key="PadButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
        <Setter Property="MinHeight" Value="48"/>
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="4"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- ===== Entradas: radio 10, foco anillo teal ===== -->
    <Style TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="10,6" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Bd" CornerRadius="10"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="10,6" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource FocusBrush}"/>
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="8,4"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="8,4"/>
    </Style>

    <!-- ===== Listas: ítem radio 10 con cápsula menta al seleccionar ===== -->
    <Style TargetType="ListBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="10" Padding="12,8" Margin="2,1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintBrush}"/>
                            <Setter Property="TextElement.Foreground" Value="{StaticResource PrimaryBrush}"/>
                            <Setter Property="TextElement.FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Ítem de menú del sidebar (prototipo .nav-item):
        alto 42, radio 10, barra izquierda 3×teal al activo,
        fondo menta suave y texto teal-700; hover #F8FAFC.
    -->
    <Style x:Key="NavMenuItem" TargetType="ListBoxItem">
        <Setter Property="Height" Value="42"/>
        <Setter Property="Padding" Value="0,0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Bar" Width="3" HorizontalAlignment="Left"
                                CornerRadius="0,1.5,1.5,0" Background="Transparent"/>
                        <Border x:Name="Bd" CornerRadius="0,10,10,0" Margin="3,1,3,1"
                                Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MintBrush}"/>
                            <Setter TargetName="Bar" Property="Background" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Chip de letra del menú (22×22 slate-100; activo tinte teal) -->
    <Style x:Key="NavKeyChip" TargetType="Border">
        <Setter Property="Width" Value="22"/>
        <Setter Property="Height" Value="22"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Background" Value="{StaticResource SubtleBrush}"/>
    </Style>

    <!-- Píldora de conteo del menú (draft venta, stock bajo) -->
    <Style x:Key="NavCountBadge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="CornerRadius" Value="999"/>
        <Setter Property="MinWidth" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Padding" Value="5,0"/>
    </Style>

    <!-- ===== Tablas: encabezado sobrio, selección con acento teal ===== -->
    <Style TargetType="DataGrid">
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderSoftBrush}"/>
        <Setter Property="RowBackground" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="AlternatingRowBackground" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="ColumnHeaderStyle">
            <Setter.Value>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Padding" Value="10,6"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Foreground" Value="{StaticResource TextSubBrush}"/>
                    <Setter Property="Background" Value="{StaticResource AppBackground}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="CellStyle">
            <Setter.Value>
                <Style TargetType="DataGridCell">
                    <Setter Property="Padding" Value="10,4"/>
                    <Setter Property="BorderThickness" Value="0,0,0,0"/>
                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="{StaticResource MintBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Modal: tarjeta radio 14 con sombra suave sobre fondo atenuado ===== -->
    <Style x:Key="DialogCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="14"/>
        <Setter Property="Padding" Value="24"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#0F172A" Opacity="0.16" BlurRadius="32" ShadowDepth="16"/>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
