<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Frubber POS — tokens tema OSCURO (preparado en JHO-69; se activa en
        JHO-71 con su toggle persistido). Valores exactos del bloque `.dark`
        de frubber-pos.html (dueño, 2026-10-02). NO se fusiona aún en
        App.xaml: el producto sigue arrancando en claro.
    -->

    <Color x:Key="AppBackgroundColor">#0B1220</Color>
    <Color x:Key="SurfaceColor">#111A26</Color>
    <Color x:Key="PrimaryColor">#14B8A6</Color>
    <Color x:Key="PrimaryActiveColor">#0D9488</Color>
    <Color x:Key="AccentColor">#14B8A6</Color>
    <Color x:Key="AccentSoftColor">#0D9488</Color>
    <Color x:Key="TextColor">#E6EAF2</Color>
    <Color x:Key="SecondaryTextColor">#A8B4C6</Color>
    <Color x:Key="MutedTextColor">#7B8AA0</Color>
    <Color x:Key="TextSubColor">#94A3B8</Color>
    <Color x:Key="BorderColor">#263449</Color>
    <Color x:Key="BorderSoftColor">#1E293B</Color>
    <Color x:Key="BorderHoverColor">#33496B</Color>
    <Color x:Key="SuccessColor">#34D399</Color>
    <Color x:Key="WarningColor">#FCD34D</Color>
    <Color x:Key="ErrorColor">#F87171</Color>
    <Color x:Key="FocusColor">#2DD4BF</Color>
    <Color x:Key="SubtleColor">#1B2534</Color>

    <Color x:Key="MintColor">#12302C</Color>
    <Color x:Key="MintHoverColor">#17202E</Color>
    <Color x:Key="MintRowColor">#0F2A2A</Color>
    <Color x:Key="MintBorderColor">#155E56</Color>
    <Color x:Key="GreenDotColor">#34D399</Color>
    <Color x:Key="WarnSoftColor">#2A2210</Color>
    <Color x:Key="ErrorSoftColor">#2A1614</Color>
    <Color x:Key="ErrorBorderColor">#7F2A2A</Color>
    <Color x:Key="ErrorHoverColor">#3A1D1A</Color>
    <Color x:Key="SuccessSoftColor">#0F2A22</Color>
    <Color x:Key="TrialColor">#3A2E12</Color>
    <Color x:Key="TrialTextColor">#FCD34D</Color>
    <Color x:Key="OfflineTextColor">#FCD34D</Color>

    <SolidColorBrush x:Key="AppBackground" Color="{StaticResource AppBackgroundColor}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource PrimaryColor}"/>
    <SolidColorBrush x:Key="PrimaryActiveBrush" Color="{StaticResource PrimaryActiveColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}"/>
    <SolidColorBrush x:Key="TextSubBrush" Color="{StaticResource TextSubColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="{StaticResource BorderHoverColor}"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>
    <SolidColorBrush x:Key="GreenDotBrush" Color="{StaticResource GreenDotColor}"/>
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}"/>
    <SolidColorBrush x:Key="OfflineTextBrush" Color="{StaticResource OfflineTextColor}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}"/>
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="{StaticResource ErrorBorderColor}"/>
    <SolidColorBrush x:Key="ErrorHoverBrush" Color="{StaticResource ErrorHoverColor}"/>
    <SolidColorBrush x:Key="FocusBrush" Color="{StaticResource FocusColor}"/>
    <SolidColorBrush x:Key="SubtleBrush" Color="{StaticResource SubtleColor}"/>
    <SolidColorBrush x:Key="MintBrush" Color="{StaticResource MintColor}"/>
    <SolidColorBrush x:Key="MintHoverBrush" Color="{StaticResource MintHoverColor}"/>
    <SolidColorBrush x:Key="MintRowBrush" Color="{StaticResource MintRowColor}"/>
    <SolidColorBrush x:Key="MintBorderBrush" Color="{StaticResource MintBorderColor}"/>
    <SolidColorBrush x:Key="WarnSoftBrush" Color="{StaticResource WarnSoftColor}"/>
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="{StaticResource ErrorSoftColor}"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}"/>
    <SolidColorBrush x:Key="TrialBrush" Color="{StaticResource TrialColor}"/>
    <SolidColorBrush x:Key="TrialTextBrush" Color="{StaticResource TrialTextColor}"/>

    <LinearGradientBrush x:Key="BrandGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2DD4BF" Offset="0"/>
        <GradientStop Color="#0F766E" Offset="1"/>
    </LinearGradientBrush>
    <!-- Fondo de login/bloqueo (body de frubber-pos-login.html, gradiente 165deg) -->
    <LinearGradientBrush x:Key="LoginBackdrop" StartPoint="0.39,0" EndPoint="0.61,1">
        <GradientStop Color="{StaticResource AppBackgroundColor}" Offset="0"/>
        <GradientStop Color="#1C2230" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AvatarGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#2DD4BF" Offset="0"/>
        <GradientStop Color="#0F766E" Offset="1"/>
    </LinearGradientBrush>

    <!-- Texto sobre marca en oscuro: tinta profunda para AA sobre teal claro -->
    <Color x:Key="OnBrandColor">#062F2B</Color>
    <SolidColorBrush x:Key="OnBrandBrush" Color="{StaticResource OnBrandColor}"/>
</ResourceDictionary>
